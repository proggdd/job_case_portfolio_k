---
/*
 * Подвал — DESIGN.md §3, блок 4.
 *
 * ── Пересмотр 09.08.2026: контакты убраны ────────────────────────────────
 * Решение заказчика: «сам подвал надо немного красивее сделать, там как были
 * кнопки старые так и остались… можно их наверное вообще убрать, и там
 * сделать какой-то суммарайз, итог или слоган».
 *
 * Прямое следствие, которое пришлось учесть: шапка больше НЕ прячется
 * у подвала (Header.astro, отмена is-hidden). Прежняя логика P11-T2 прятала
 * её именно потому, что подвал дублировал контакты и видеть их дважды было
 * незачем. Контактов внизу больше нет — спрятанная шапка оставила бы
 * пользователя в самом низу страницы вообще без способа связаться.
 *
 * ── Ссылка «На главную»: вернулась 11.08.2026 ────────────────────────────
 * 09.08 её убрали отсюда по решению заказчика («кнопку на главную убрать
 * из подвала везде, оставить липучку») и увели в плавающие кнопки.
 * 11.08 Даниил вернул обратно: «клавишу на главную запихать в подвал».
 * Это осознанный откат, а не потеря — не убирать снова, не разобравшись.
 *
 * Плавающей осталась только «Наверх» (FloatingControls.astro), проп
 * showHomeLink переехал сюда.
 *
 * Оформление — вторичная кнопка шапки («Резюме»), тот же вид, что теперь
 * и у «Наверх»: на сайте два вида кнопок, сплошная красная и обводка,
 * третьего не заводим.
 *
 * Высота 64px из DESIGN.md была рассчитана на подвал-с-контактами; строка
 * с текстом в неё укладывается, поэтому min-height с тем же числом сохранён.
 */
import { withBase } from '../lib/url';

interface Props {
	/** Показывать «На главную». Снята только на самой главной. */
	showHomeLink?: boolean;
}

const { showHomeLink = true } = Astro.props;
---

<footer class="site-footer" data-footer>
	<div class="site-footer__inner container">
		{showHomeLink && (
			<a class="site-footer__home" href={withBase('')}>
				<svg class="site-footer__home-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path
						d="M20 12H4M4 12l6.5-6.5M4 12l6.5 6.5"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				На главную
			</a>
		)}

		{/*
		  ⚠️ ЧЕРНОВИК ТЕКСТА, ждёт утверждения Кирилла (карточка K-8).
		  Написан про подход к работе, а не про конкретные проекты: подвал
		  общий для всех страниц и переживёт смену портфолио.
		*/}
		<p class="site-footer__note">Проектирую интерфейсы, которые понятны без инструкции.</p>
	</div>
</footer>

<style>
	.site-footer {
		min-height: 64px; /* DESIGN.md §3: полоса высотой 64px */
		background-color: var(--color-surface); /* DESIGN.md §2: «нижняя полоса» */
		border-top-left-radius: var(--radius-footer-top); /* DESIGN.md §2: 0px сверху */
		border-top-right-radius: var(--radius-footer-top);
		padding-block: var(--space-header-to-hero); /* переиспользован тот же токен вертикального дыхания, что у шапки */
	}

	.site-footer__inner {
		min-height: 64px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: calc(var(--space-unit) * 2);
	}

	/* Строка-итог. Размер — токен «подзаголовок кейса», самая мелкая из уже
	   измеренных текстовых ролей: подвал не должен спорить с содержимым
	   страницы. Своей роли для подвала в DESIGN.md §2 нет, новое значение
	   не заводилось. */
	.site-footer__note {
		max-width: none; /* переопределяет 66ch из typography.css: строка короткая */
		font-family: var(--font-body);
		font-size: var(--text-case-subtitle-size);
		line-height: var(--text-case-subtitle-line-height);
		font-weight: var(--text-case-subtitle-weight);
		color: var(--color-text-muted);
	}

	/*
	 * «На главную» — оформление вторичной кнопки шапки («Резюме»), правка
	 * 11.08.2026. Те же токены, что у .header-button--outline: высота
	 * элемента управления, полная капсула, обводка внутренней тенью
	 * (не border — он съел бы высоту при box-sizing: border-box).
	 */
	.site-footer__home {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: calc(var(--space-unit) * 2);
		flex-shrink: 0;
		height: var(--size-header-control);
		padding-inline: var(--space-header-button-padding);
		border-radius: var(--radius-pill-full);
		font-family: var(--font-body);
		font-size: var(--text-header-button-size);
		font-weight: var(--text-button-weight);
		white-space: nowrap;
		background-color: transparent;
		color: var(--color-text);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-outline);
		transition:
			background-color 180ms ease-out,
			color 180ms ease-out,
			box-shadow 180ms ease-out;
	}

	.site-footer__home:hover {
		text-decoration: none; /* отменяет глобальное подчёркивание ссылок */
		background-color: var(--color-text);
		color: var(--color-bg);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-solid);
	}

	/* Вход в нажатие мгновенный — тот же приём, что у кнопок шапки (B4). */
	.site-footer__home:active {
		background-color: var(--color-button-outline-active);
		color: var(--color-bg);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-outline);
		transition-duration: 0ms;
	}

	.site-footer__home:focus-visible {
		outline: 2px solid var(--color-text); /* DESIGN.md §7: видимый фокус */
		outline-offset: 2px;
		text-decoration: none;
	}

	/* reset.css даёт svg display: block, и как флекс-элемент он сжимается
	   до нулевой ширины — тот же капкан, что у иконок в шапке. */
	.site-footer__home-icon {
		flex-shrink: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer__home {
			transition: none;
		}
	}

	@media (min-width: 600px) {
		.site-footer__inner {
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
			gap: calc(var(--space-unit) * 8);
		}

		/* Без ссылки «На главную» (на самой главной) строка-итог остаётся
		   у правого края, а не уезжает влево — та же ось, что у панели
		   контактов в шапке. Со ссылкой правило не действует: space-between
		   сам разводит их по краям. */
		.site-footer__note:only-child {
			margin-left: auto;
		}
	}
</style>
