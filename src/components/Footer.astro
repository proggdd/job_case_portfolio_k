---
/*
 * Подвал — DESIGN.md §3, блок 4.
 *
 * ── Пересмотр 09.08.2026: контакты убраны ────────────────────────────────
 * Решение заказчика: «сам подвал надо немного красивее сделать, там как были
 * кнопки старые так и остались… можно их наверное вообще убрать, и там
 * сделать какой-то суммарайз, итог или слоган».
 *
 * Прямое следствие, которое пришлось учесть: шапка больше НЕ прячется
 * у подвала (Header.astro, отмена is-hidden). Прежняя логика P11-T2 прятала
 * её именно потому, что подвал дублировал контакты и видеть их дважды было
 * незачем. Контактов внизу больше нет — спрятанная шапка оставила бы
 * пользователя в самом низу страницы вообще без способа связаться.
 *
 * Ссылка «На главную» остаётся: в теле страницы кейса её нет, а из низа
 * страницы уходить куда-то нужно.
 *
 * Высота 64px из DESIGN.md была рассчитана на подвал-с-контактами; строка
 * с текстом в неё укладывается, поэтому min-height с тем же числом сохранён.
 */
import { withBase } from '../lib/url';

interface Props {
	showHomeLink?: boolean;
}

const { showHomeLink = true } = Astro.props;
---

<footer class="site-footer" data-footer>
	<div class="site-footer__inner container">
		{showHomeLink && <a class="site-footer__home" href={withBase('')}>← На главную</a>}
		{/*
		  ⚠️ ЧЕРНОВИК ТЕКСТА, ждёт утверждения Кирилла (карточка K-8).
		  Написан про подход к работе, а не про конкретные проекты: подвал
		  общий для всех страниц и переживёт смену портфолио.
		*/}
		<p class="site-footer__note">Проектирую интерфейсы, которые понятны без инструкции.</p>
	</div>
</footer>

<style>
	.site-footer {
		min-height: 64px; /* DESIGN.md §3: полоса высотой 64px */
		background-color: var(--color-surface); /* DESIGN.md §2: «нижняя полоса» */
		border-top-left-radius: var(--radius-footer-top); /* DESIGN.md §2: 0px сверху */
		border-top-right-radius: var(--radius-footer-top);
		padding-block: var(--space-header-to-hero); /* переиспользован тот же токен вертикального дыхания, что у шапки */
	}

	.site-footer__inner {
		min-height: 64px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: calc(var(--space-unit) * 2);
	}

	.site-footer__home {
		align-self: flex-start;
		color: var(--color-text-muted); /* тот же приём, что case-page__back и not-found__link */
	}

	.site-footer__home:focus-visible {
		outline: 2px solid var(--color-text); /* DESIGN.md §7: видимый фокус */
		outline-offset: 4px;
	}

	/* Строка-итог. Размер — токен «подзаголовок кейса», самая мелкая из уже
	   измеренных текстовых ролей: подвал не должен спорить с содержимым
	   страницы. Своей роли для подвала в DESIGN.md §2 нет, новое значение
	   не заводилось. */
	.site-footer__note {
		max-width: none; /* переопределяет 66ch из typography.css: строка короткая */
		font-family: var(--font-body);
		font-size: var(--text-case-subtitle-size);
		line-height: var(--text-case-subtitle-line-height);
		font-weight: var(--text-case-subtitle-weight);
		color: var(--color-text-muted);
	}

	@media (min-width: 600px) {
		.site-footer__inner {
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
			gap: calc(var(--space-unit) * 8);
		}

		/* Без ссылки «На главную» (на самой главной) строка-итог остаётся
		   у правого края, а не уезжает влево — та же ось, что у панели
		   контактов в шапке. */
		.site-footer__note {
			margin-left: auto;
		}
	}
</style>
