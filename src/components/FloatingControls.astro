---
/*
 * Плавающая кнопка «Наверх» в правом нижнем углу.
 *
 * ── Правка 11.08.2026 ────────────────────────────────────────────────────
 * Две изменения по решению Даниила:
 *
 * 1. «На главную» переехала в подвал (Footer.astro) и отсюда убрана —
 *    вместе с пропом showHomeLink, компонент больше ничего не принимает.
 *    История у этой ссылки длинная: она жила внутри страницы кейса, потом
 *    в шапке слева, потом в подвале, потом здесь. Возврат в подвал —
 *    осознанный откат к варианту 09.08, а не потеря.
 *
 * 2. Кнопка оформлена как вторичная кнопка шапки («Резюме»): обводка
 *    в 1.5px, полная капсула, те же высота, отклик и тень. Было матовое
 *    стекло (--glass-*) — своя, четвёртая по счёту форма кнопки на сайте.
 *    Теперь на всех кнопках сайта два вида: сплошная красная и обводка.
 *
 * Подъём над подвалом: высота подвала разная по страницам, статическим
 * отступом не покрыть — читаем фактическую высоту в момент его появления.
 *
 * Наблюдатель за подвалом получает rootMargin снизу: подъём начинается
 * ДО того, как подвал въедет в экран. Без этого кнопка успевала наехать
 * на серую полосу и только потом поднималась — замечание заказчика
 * «сначала наезжают на фон подвала и потом медленно поднимаются».
 * Длительность подъёма отдельная и короткая по той же причине.
 */
---

<div class="floating-controls" data-floating-controls>
	<button class="floating-button floating-controls__top" data-back-to-top type="button" aria-label="Наверх">
		<svg class="floating-button__icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
			<path
				d="M10 16V4M10 4L4.5 9.5M10 4L15.5 9.5"
				fill="none"
				stroke="currentColor"
				stroke-width="1.75"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
	</button>
</div>

<script>
	const controls = document.querySelector<HTMLElement>('[data-floating-controls]');
	const topButton = document.querySelector<HTMLElement>('[data-back-to-top]');
	const sentinel = document.querySelector<HTMLElement>('[data-viewport-sentinel]');
	const footer = document.querySelector<HTMLElement>('[data-footer]');

	if (controls && sentinel) {
		// на первом экране кнопки не нужны: верх и так рядом
		const visibilityObserver = new IntersectionObserver(([entry]) => {
			controls.classList.toggle('is-visible', !entry.isIntersecting);
		});
		visibilityObserver.observe(sentinel);
	}

	if (controls && footer) {
		const liftObserver = new IntersectionObserver(
			([entry]) => {
				controls.style.setProperty('--floating-lift', `${footer.offsetHeight}px`);
				controls.classList.toggle('is-lifted', entry.isIntersecting);
			},
			// подъём начинается, пока подвал ещё за нижним краем экрана
			{ rootMargin: '0px 0px 120px 0px' }
		);
		liftObserver.observe(footer);
	}

	if (topButton) {
		topButton.addEventListener('click', () => {
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
		});
	}
</script>

<style>
	.floating-controls {
		position: fixed;
		/* Отступ от краёв — тот же, что боковое поле контейнера на десктопе
		   (DESIGN.md §5, 80px даёт контент 1280 при 1440 — C6). */
		left: var(--space-content-padding);
		right: var(--space-content-padding);
		bottom: var(--space-content-padding);
		z-index: 10; /* тот же слой, что у шапки */

		display: flex;
		align-items: center;
		justify-content: space-between;
		pointer-events: none; /* полоса-обёртка не должна перехватывать клики по странице */

		/* Скрыты на первом экране */
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px);
		transition:
			opacity 300ms ease-out,
			transform 300ms ease-out,
			visibility 300ms,
			/* Подъём над подвалом заметно быстрее появления: иначе кнопки
			   успевают наехать на серую полосу и медленно всплывают. */
			bottom 160ms ease-out;
	}

	.floating-controls.is-visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.floating-controls.is-lifted {
		bottom: calc(var(--floating-lift, 0px) + var(--space-content-padding));
	}

	/* Кнопка одна и прижата к правому краю. */
	.floating-controls__top {
		margin-left: auto;
	}

	/*
	 * Оформление вторичной кнопки шапки («Резюме»), правка 11.08.2026.
	 * Те же токены, что у .header-button--outline в Header.astro: высота
	 * элемента управления, полная капсула, обводка 1.5px внутренней тенью
	 * (не border — он съел бы высоту при box-sizing: border-box), та же
	 * тень и та же длительность отклика.
	 */
	.floating-button {
		pointer-events: auto; /* сама кнопка кликабельна, в отличие от обёртки */
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: var(--size-header-control);
		width: var(--size-header-control); /* квадрат: внутри только стрелка */
		border-radius: var(--radius-pill-full);
		font-family: var(--font-body);
		font-size: var(--text-header-button-size);
		font-weight: var(--text-button-weight);
		/* .floating-controls__top — нативный <button>: reset.css обнуляет
		   у button только font/color, не border. У Chrome и Firefox
		   дефолтная рамка кнопки рисуется style: outset — это подсветка
		   с одной стороны и затемнение с другой на одном border-color,
		   отсюда серая половина кольца поверх нашей box-shadow-обводки.
		   appearance: none убирает и системный фон/паддинг заодно. */
		appearance: none;
		border: none;
		background-color: transparent;
		color: var(--color-text);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-outline);
		transition:
			background-color 180ms ease-out,
			color 180ms ease-out,
			box-shadow 180ms ease-out;
	}

	.floating-button:hover {
		background-color: var(--color-text);
		color: var(--color-bg);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-solid);
	}

	/* Вход в нажатие мгновенный: состояние живёт 80–120 мс при обычном
	   клике и на плавном переходе не успевало бы стать видимым (B4). */
	.floating-button:active {
		background-color: var(--color-button-outline-active);
		color: var(--color-bg);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-outline);
		transition-duration: 0ms;
	}

	.floating-button:hover,
	.floating-button:focus-visible {
		text-decoration: none; /* отменяет глобальное подчёркивание ссылок */
	}

	.floating-button:focus-visible {
		outline: 2px solid var(--color-text); /* DESIGN.md §7: видимый фокус */
		outline-offset: 2px;
	}

	/* Тот же капкан, что со значком чата в шапке: reset.css даёт svg
	   display: block, и как флекс-элемент он сжимается до нулевой ширины. */
	.floating-button__icon {
		flex-shrink: 0;
	}

	@media (max-width: 599px) {
		.floating-controls {
			/* На мобильном поля контейнера 20px (DESIGN.md §5) */
			left: 20px;
			right: 20px;
			bottom: 20px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.floating-controls,
		.floating-button {
			transition: none; /* DESIGN.md §4: состояния переключаются мгновенно */
		}
	}
</style>
