---
/*
 * Список пилюль-контактов. Единственное место, где рисуется разметка пилюли —
 * шапка (Header.astro) и подвал (Footer.astro) используют этот компонент,
 * не дублируя вёрстку (DESIGN.md §3 «Контакты — один источник»).
 *
 * Шрифт, цвет текста и подчёркивание на hover/focus пилюля наследует от
 * глобального стиля `a` в typography.css — там же зафиксировано, что пилюли
 * сейчас единственные ссылки в макете. Здесь только то, что не покрыто
 * глобальным стилем: форма пилюли и фон.
 *
 * ── Режим iconsOnly, добавлен 09.08.2026 ─────────────────────────────────
 * По решению заказчика шапка показывает только значки, без подписей:
 * «наверху страницы было видно 3 значка, без подписи». Подпись при этом
 * не исчезает из разметки, а уходит в visually-hidden — скринридер и
 * клавиатура продолжают получать нормальные названия ссылок.
 *
 * Это не повтор ошибки 05.08. Тогда иконки-без-подписей ставили на МОБИЛЬНОМ
 * как единственный вариант, и пользователь справедливо возразил: «на мобильном
 * не видно ни одного слова, только три стрелки». Сейчас режим включается
 * только в шапке на десктопе, где рядом есть и подписи в подвале, и страница
 * /contacts; на мобильном шапка по-прежнему показывает кнопку «Контакты»
 * словом (Header.astro).
 *
 * Значки нарисованы здесь же, а не подключены библиотекой (DESIGN.md §1:
 * без сторонних зависимостей). Все три в одной сетке 24×24 с обводкой 1.75
 * и скруглёнными концами — единый монолинейный набор, как договаривались:
 * ink занимает почти весь бокс, в отличие от прежней стрелки, у которой
 * рисунок был вчетверо меньше своего поля.
 *
 * Для «Резюме» бренда не существует, поэтому значок собран по смыслу:
 * страница с загнутым углом и строчками текста — узнаваемое обозначение
 * документа.
 */
import { contacts, type ContactIcon } from '../data/contacts.ts';

interface Props {
	/** Только значки, подписи — в visually-hidden. Используется шапкой. */
	iconsOnly?: boolean;
}

const { iconsOnly = false } = Astro.props;

/* Пути значков — 24×24, обводка задаётся в разметке ниже. */
const iconPaths: Record<ContactIcon, string[]> = {
	telegram: ['M21.5 3.5 2.5 10.6l6.4 2.5 2.5 6.4 10.1-16z', 'M21.5 3.5 8.9 13.1'],
	email: ['M3 6h18v12H3z', 'm3 7 9 6 9-6'],
	resume: ['M6 2.5h7.5L18.5 7.5V21.5H6z', 'M13.5 2.5V7.5H18.5', 'M9 12.5h6.5', 'M9 16.5h6.5'],
};
---

<ul class:list={['contact-pills', iconsOnly && 'contact-pills--icons']}>
	{contacts.map((contact) => (
		<li class="contact-pills__item">
			<a
				class="contact-pill"
				href={contact.href}
				target={contact.external ? '_blank' : undefined}
				rel={contact.external ? 'noopener noreferrer' : undefined}
			>
				{iconsOnly && (
					<svg
						class="contact-pill__icon"
						width="22"
						height="22"
						viewBox="0 0 24 24"
						aria-hidden="true"
						focusable="false"
					>
						{iconPaths[contact.icon].map((d) => (
							<path
								d={d}
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
							></path>
						))}
					</svg>
				)}
				<span class:list={['contact-pill__label', iconsOnly && 'visually-hidden']}>{contact.label}</span>
				{contact.external && <span class="visually-hidden">(откроется в новом окне)</span>}
			</a>
		</li>
	))}
</ul>

<style>
	.contact-pills {
		display: flex;
		align-items: center;
		justify-content: center; /* P11-T3: подвал стал колонкой и растягивает список на всю ширину — без центрирования пилюли уехали бы влево */
		min-width: 0; /* позволяет списку сжиматься меньше суммарной ширины пилюль — без этого overflow-x на мобильном ниже не сработал бы */
		/* 8px — DESIGN.md не задаёт зазор между пилюлями; инженерный дефолт на базовой единице,
		   по образцу решения из P4-T2 для роли «абзац». */
		gap: calc(var(--space-unit) * 2);
	}

	.contact-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0; /* пилюля не сжимается и не теряет текст при горизонтальной прокрутке группы на мобильном */
		gap: 4px; /* DESIGN.md §2 «Прочее»: отбивка значка от текста флекс-отступом, не пробелом в разметке (ловушка compressHTML: 'jsx') */
		height: 44px; /* DESIGN.md §2 давал 37px — увеличено 05.08 по прямому запросу пользователя («слишком маленькие кнопки»), вместе с шапкой (Header.astro) */
		/* 16px горизонтальный внутренний отступ — не задан в DESIGN.md, инженерный дефолт на базовой единице */
		padding-inline: calc(var(--space-unit) * 4);
		border-radius: var(--radius-pill);
		background-color: var(--color-pill-bg);
	}

	/* Режим значков: пилюля становится квадратной по высоте — подписи нет,
	   и горизонтальный отступ, рассчитанный на текст, сделал бы её вытянутой. */
	.contact-pills--icons .contact-pill {
		width: 44px;
		padding-inline: 0;
	}

	.contact-pill:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 2px;
	}

	.contact-pill__icon {
		flex-shrink: 0;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* Правка 05.08.2026 (после отзыва пользователя): мобильный (<600px,
	   DESIGN.md §5) — вместо скрытия подписей группа пилюль прокручивается
	   горизонтально целиком, текст виден всегда. Скроллится именно группа,
	   не страница (DESIGN.md §3 запрещает только прокрутку страницы).
	   Режима значков это не касается: в шапке на мобильном стоит кнопка
	   «Контакты» словом, а сюда попадает только подвал и /contacts. */
	@media (max-width: 599px) {
		.contact-pills:not(.contact-pills--icons) {
			justify-content: flex-start; /* при прокрутке первая пилюля должна начинаться от края, а не «висеть» по центру */
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			padding-block: calc(var(--space-unit) * 1); /* небольшой запас, чтобы фокус-обводка пилюль не обрезалась краем скролл-контейнера */
		}
	}
</style>
