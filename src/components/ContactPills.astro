---
/*
 * Список пилюль-контактов. Единственное место, где рисуется разметка пилюли —
 * шапка (Header.astro) и подвал (Footer.astro) используют этот компонент,
 * не дублируя вёрстку (DESIGN.md §3 «Контакты — один источник»).
 *
 * Шрифт, цвет текста и подчёркивание на hover/focus пилюля наследует от
 * глобального стиля `a` в typography.css — там же зафиксировано, что пилюли
 * сейчас единственные ссылки в макете. Здесь только то, что не покрыто
 * глобальным стилем: форма пилюли и фон.
 *
 * P11-T1 (05.08.2026): на 375px три пилюли с подписями не помещались в ряд —
 * группа шире контейнера и толкала страницу в горизонтальную прокрутку
 * (DESIGN.md §3 «Поведение шапки и подвала»: горизонтальная прокрутка всей
 * страницы недопустима). Выбранный из трёх допустимых вариантов способ —
 * «сокращение подписей до иконок»: на мобильном (<600px, брейкпоинт DESIGN.md
 * §5) подпись прячется тем же приёмом visually-hidden, что уже применялся
 * для пометки «(откроется в новом окне)» — остаётся в DOM для скринридера,
 * пропадает только визуально. Перенос строкой или горизонтальная прокрутка
 * самой группы пилюль не выбраны: три иконки в ряд без подписи убирают
 * причину тесноты полностью, не добавляя вторую строку в шапку.
 */
import { contacts } from '../data/contacts.ts';
---

<ul class="contact-pills">
	{contacts.map((contact) => (
		<li class="contact-pills__item">
			<a
				class="contact-pill"
				href={contact.href}
				target={contact.external ? '_blank' : undefined}
				rel={contact.external ? 'noopener noreferrer' : undefined}
			>
				<span class="contact-pill__label">{contact.label}</span>
				<svg
					class="contact-pill__icon"
					width="16"
					height="16"
					viewBox="0 0 16 16"
					aria-hidden="true"
					focusable="false"
				>
					<path
						d="M4 12L12 4M8 4H12V8"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					></path>
				</svg>
				{contact.external && <span class="visually-hidden">(откроется в новом окне)</span>}
			</a>
		</li>
	))}
</ul>

<style>
	.contact-pills {
		display: flex;
		align-items: center;
		justify-content: center; /* P11-T3: подвал стал колонкой и растягивает список на всю ширину — без центрирования пилюли уехали бы влево */
		/* 8px — DESIGN.md не задаёт зазор между пилюлями; инженерный дефолт на базовой единице,
		   по образцу решения из P4-T2 для роли «абзац». */
		gap: calc(var(--space-unit) * 2);
	}

	.contact-pill {
		display: inline-flex;
		align-items: center;
		gap: 4px; /* DESIGN.md §2 «Прочее»: отбивка иконки-стрелки от текста — флекс-отступом, не пробелом в разметке (compressHTML: 'jsx') */
		height: 37px; /* DESIGN.md §2 «Скругления»: высота пилюли контакта */
		/* 16px горизонтальный внутренний отступ — не задан в DESIGN.md, инженерный дефолт на базовой единице */
		padding-inline: calc(var(--space-unit) * 4);
		border-radius: var(--radius-pill);
		background-color: var(--color-pill-bg);
	}

	.contact-pill:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 2px;
	}

	.contact-pill__icon {
		flex-shrink: 0;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* P11-T1: мобильный (<600px, DESIGN.md §5) — подпись пилюли прячется тем
	   же приёмом, что .visually-hidden выше, чтобы три пилюли уместились
	   в ряд без горизонтальной прокрутки страницы. В DOM подпись остаётся —
	   скринридер читает её как раньше, пропадает только картинка. */
	@media (max-width: 599px) {
		.contact-pill__label {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.contact-pill {
			gap: 0; /* нет видимого текста рядом с иконкой — отбивка не нужна */
			padding-inline: calc(var(--space-unit) * 3); /* 12px: чуть теснее вокруг одной иконки, чем вокруг иконки с текстом */
		}
	}
</style>
