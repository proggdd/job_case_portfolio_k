---
/*
 * Список пилюль-контактов. Единственное место, где рисуется разметка пилюли —
 * шапка (Header.astro) и подвал (Footer.astro) используют этот компонент,
 * не дублируя вёрстку (DESIGN.md §3 «Контакты — один источник»).
 *
 * Шрифт, цвет текста и подчёркивание на hover/focus пилюля наследует от
 * глобального стиля `a` в typography.css — там же зафиксировано, что пилюли
 * сейчас единственные ссылки в макете. Здесь только то, что не покрыто
 * глобальным стилем: форма пилюли и фон.
 *
 * P11-T1 (05.08.2026): на 375px три пилюли с подписями не помещались в ряд —
 * группа шире контейнера и толкала страницу в горизонтальную прокрутку
 * (DESIGN.md §3 «Поведение шапки и подвала»: горизонтальная прокрутка всей
 * страницы недопустима). Первая попытка — «сокращение подписей до иконок»
 * (спрятать текст visually-hidden) — по прямой обратной связи пользователя
 * не подошла: на мобильном не видно ни одного слова, только три стрелки.
 *
 * Правка того же дня: заменено на третий из трёх вариантов DESIGN.md §3 —
 * «горизонтальная прокрутка группы» (не страницы целиком — это по-прежнему
 * запрещено). Текст остаётся видимым всегда, у кого пилюли не помещаются
 * в 375px — прокручивает саму группу пальцем. `.contact-pills` получает
 * `overflow-x: auto` и `min-width: 0` на мобильном; чтобы прокрутка была
 * возможна, а не съедалась авто-раскладкой родителя, `.site-header__inner`
 * (Header.astro) на мобильном переключается с трёхколоночной центрирующей
 * сетки `1fr auto 1fr` на `auto minmax(0, 1fr)` — см. комментарий там же.
 */
import { contacts } from '../data/contacts.ts';
---

<ul class="contact-pills">
	{contacts.map((contact) => (
		<li class="contact-pills__item">
			<a
				class="contact-pill"
				href={contact.href}
				target={contact.external ? '_blank' : undefined}
				rel={contact.external ? 'noopener noreferrer' : undefined}
			>
				<span class="contact-pill__label">{contact.label}</span>
				<svg
					class="contact-pill__icon"
					width="18"
					height="18"
					viewBox="0 0 16 16"
					aria-hidden="true"
					focusable="false"
				>
					<path
						d="M4 12L12 4M8 4H12V8"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					></path>
				</svg>
				{contact.external && <span class="visually-hidden">(откроется в новом окне)</span>}
			</a>
		</li>
	))}
</ul>

<style>
	.contact-pills {
		display: flex;
		align-items: center;
		justify-content: center; /* P11-T3: подвал стал колонкой и растягивает список на всю ширину — без центрирования пилюли уехали бы влево */
		min-width: 0; /* позволяет списку сжиматься меньше суммарной ширины пилюль — без этого overflow-x на мобильном ниже не сработал бы */
		/* 8px — DESIGN.md не задаёт зазор между пилюлями; инженерный дефолт на базовой единице,
		   по образцу решения из P4-T2 для роли «абзац». */
		gap: calc(var(--space-unit) * 2);
	}

	.contact-pill {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0; /* пилюля не сжимается и не теряет текст при горизонтальной прокрутке группы на мобильном */
		gap: 4px; /* DESIGN.md §2 «Прочее»: отбивка иконки-стрелки от текста — флекс-отступом, не пробелом в разметке (compressHTML: 'jsx') */
		height: 44px; /* DESIGN.md §2 давал 37px — увеличено 05.08 по прямому запросу пользователя («слишком маленькие кнопки»), вместе с шапкой (Header.astro) */
		/* 16px горизонтальный внутренний отступ — не задан в DESIGN.md, инженерный дефолт на базовой единице */
		padding-inline: calc(var(--space-unit) * 4);
		border-radius: var(--radius-pill);
		background-color: var(--color-pill-bg);
	}

	.contact-pill:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 2px;
	}

	.contact-pill__icon {
		flex-shrink: 0;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* Правка 05.08.2026 (после отзыва пользователя): мобильный (<600px,
	   DESIGN.md §5) — вместо скрытия подписей группа пилюль прокручивается
	   горизонтально целиком, текст виден всегда. Скроллится именно группа,
	   не страница (DESIGN.md §3 запрещает только прокрутку страницы). */
	@media (max-width: 599px) {
		.contact-pills {
			justify-content: flex-start; /* при прокрутке первая пилюля должна начинаться от края, а не «висеть» по центру */
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			padding-block: calc(var(--space-unit) * 1); /* небольшой запас, чтобы фокус-обводка пилюль не обрезалась краем скролл-контейнера */
		}
	}
</style>
