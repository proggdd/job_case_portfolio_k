---
/*
 * Кнопка «наверх» — правый нижний угол, добавлена 09.08.2026 по прямому
 * запросу заказчика: «в том же стеклянном стиле как и все остальные,
 * надпись не нужна, можно просто аккуратную стрелочку вверх».
 *
 * Стекло — те же токены --glass-*, что у капсул шапки (DESIGN.md §4).
 * Без -webkit-префикса: минификатор схлопывает пару объявлений и оставляет
 * префиксную строку, которую Chrome уже не понимает — история из коммита
 * 1778c4d, повторять её тут не нужно.
 *
 * Появляется по тому же наблюдателю, что и сжатие шапки: пока виден
 * [data-viewport-sentinel] (первый экран), кнопка не нужна. Отдельного
 * обработчика scroll нет — DESIGN.md §3 прямо запрещает его как приём.
 *
 * Это <button>, а не ссылка на #top: якорь добавил бы запись в историю
 * браузера, и «назад» уводил бы не на предыдущую страницу, а на прежнюю
 * позицию прокрутки.
 *
 * Размер 52px — высота сжатой капсулы шапки (Header.astro, is-compact),
 * не новое число.
 */
---

<button class="back-to-top" data-back-to-top type="button" aria-label="Наверх">
	<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
		<path
			d="M10 16V4M10 4L4.5 9.5M10 4L15.5 9.5"
			fill="none"
			stroke="currentColor"
			stroke-width="1.75"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
	</svg>
</button>

<script>
	const button = document.querySelector<HTMLElement>('[data-back-to-top]');
	const sentinel = document.querySelector<HTMLElement>('[data-viewport-sentinel]');

	if (button && sentinel) {
		const observer = new IntersectionObserver(([entry]) => {
			button.classList.toggle('is-visible', !entry.isIntersecting);
		});
		observer.observe(sentinel);

		button.addEventListener('click', () => {
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
		});
	}
</script>

<style>
	.back-to-top {
		position: fixed;
		/* Отступ от края — тот же, что боковое поле контейнера на десктопе
		   (DESIGN.md §5, 50px даёт контент 1340 при 1440). */
		right: var(--space-content-padding);
		bottom: var(--space-content-padding);
		z-index: 10; /* тот же слой, что у шапки */

		display: grid;
		place-items: center;
		width: 52px; /* высота сжатой капсулы шапки, Header.astro */
		height: 52px;
		border-radius: 50%;
		color: var(--color-text);

		/* Матовое стекло — те же токены, что у капсул шапки, DESIGN.md §4 */
		background-color: var(--glass-bg);
		border: 1px solid var(--glass-border);
		box-shadow: var(--glass-shadow);
		backdrop-filter: blur(var(--glass-blur)) saturate(1.4);

		/* Скрыта на первом экране: там верх и так рядом */
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px);
		transition:
			opacity 300ms ease-out,
			transform 300ms ease-out,
			visibility 300ms; /* DESIGN.md §4: 300 мс ease-out на состояния шапки, тот же тайминг */
	}

	.back-to-top.is-visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.back-to-top:focus-visible {
		outline: 2px solid var(--color-text); /* DESIGN.md §7: видимый фокус */
		outline-offset: 2px;
	}

	@media (max-width: 599px) {
		.back-to-top {
			/* На мобильном поля контейнера 20px (DESIGN.md §5) */
			right: 20px;
			bottom: 20px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.back-to-top {
			transition: none; /* DESIGN.md §4: состояния переключаются мгновенно */
		}
	}
</style>
