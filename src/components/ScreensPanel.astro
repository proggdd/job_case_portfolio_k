---
/*
 * Панель экранов приложения — DESIGN.md §3, «Панель экранов».
 *
 * Редакция 02.09.2026. Раньше компонент раскладывал ряд отдельных
 * телефонов флексом внутри тёмной подложки (подложка 1160×650, экран
 * 251×510, зазор 80, пропорции в процентах). Раскладка ломалась: у
 * картинки телефона задан aspect-ratio, ширину она брала из натуральной
 * (502px), а не из flex-basis, и на широких экранах вылезала из подложки
 * на ~280px, наезжая на соседний текст.
 *
 * Теперь панель — это один готовый кадр из Figma (тёмная подложка
 * --color-surface-raised, телефоны, стрелки и скругление уже впечатаны
 * в PNG-выгрузку, углы прозрачны). Компонент только выкладывает кадр
 * во всю ширину колонки кейса. Никакой своей геометрии, подложки и
 * скруглений — их задаёт сам файл.
 *
 * screens — массив: у блока может быть больше одного кадра, тогда они
 * идут стопкой с тем же зазором, что между карточками на странице.
 * В данных кейса iq-auto у каждого блока ровно один кадр.
 *
 * Пропорция кадра 2320×1300 закреплена в aspect-ratio и атрибутах
 * width/height — страница не «прыгает», пока файл грузится (CLS).
 */
import { withBase } from '../lib/url';

interface Props {
	/** Пути к кадрам-панелям относительно public/ */
	screens: string[];
	/** Что за панель — уходит в alt каждого кадра */
	label: string;
}

const { screens, label } = Astro.props;
---

<div class="screens-panel">
	{
		screens.map((src, index) => (
			<img
				class="screens-panel__frame"
				src={withBase(src)}
				alt={screens.length > 1 ? `${label}, кадр ${index + 1} из ${screens.length}` : label}
				width="2320"
				height="1300"
				loading="lazy"
				decoding="async"
			/>
		))
	}
</div>

<style>
	.screens-panel {
		display: flex;
		flex-direction: column;
		gap: var(--space-case-cards-gap);
	}

	.screens-panel__frame {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2320 / 1300;
	}
</style>
