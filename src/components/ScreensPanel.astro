---
/*
 * Тёмная панель с рядом экранов приложения — DESIGN.md §3, «Панель экранов».
 *
 * Пропорции вместо пикселей. В макете подложка 1160 × 650, экран 251 × 510,
 * зазор 80. Записаны отношением к ширине подложки (251/1160 = 21.638%,
 * 80/1160 = 6.897%) и пропорцией самой подложки 1160/650. Иначе при сужении
 * колонки подложка ужималась бы, а экраны фиксированной ширины вылезали
 * бы за её края.
 *
 * Ниже 1024 подложка не рисуется — экраны лежат прямо на белом [561:6981].
 * Это свойство компонента, а не второй компонент: на 358px плашка с полями
 * съела бы ширину. Полноценная мобильная страница кейса (узел [561:6599],
 * там на раздел идёт одна полоса 358 × 201, а не ряд экранов) — отдельная
 * задача, здесь только не ломается.
 *
 * Соединительные стрелки между экранами в вёрстку не идут: это разметка
 * макета поверх экранов, она поясняет переходы читателю Figma.
 */
import { withBase } from '../lib/url';

interface Props {
	/** Пути к экранам относительно public/ */
	screens: string[];
	/** Что за ряд — уходит в alt каждого экрана */
	label: string;
}

const { screens, label } = Astro.props;
---

<div class="screens-panel">
	<div class="screens-panel__row">
		{
			screens.map((src, index) => (
				<img
					class="screens-panel__screen"
					src={withBase(src)}
					alt={`${label}, экран ${index + 1} из ${screens.length}`}
					width="502"
					height="1020"
					loading="lazy"
					decoding="async"
				/>
			))
		}
	</div>
</div>

<style>
	.screens-panel__row {
		display: flex;
		justify-content: center;
		align-items: center;
		/* Своего зазора для мобильной раскладки в спецификации нет; взят уже
		   принятый на этой странице зазор между карточками, а не выдумано
		   новое число. Десктопный 80 — в медиазапросе ниже. */
		gap: var(--space-case-cards-gap);
	}

	.screens-panel__screen {
		/* До 1024 экраны делят ширину поровну и ужимаются вместе с колонкой;
		   251 — верхняя граница, шире экрана в макете нет. */
		flex: 1 1 0;
		max-width: var(--size-case-screen);
		height: auto;
		aspect-ratio: 251 / 510;
		object-fit: cover;
		/* Скругления углов экрана нет: оно уже впечатано в PNG-альфу
		   выгрузки (все файлы VP8X с прозрачностью). Своего значения
		   спецификация не даёт, и выдумывать его здесь нечего. */
	}

	@media (min-width: 1024px) {
		.screens-panel {
			/* 650 = 1160 × 0.5603: подложка сужается вместе с колонкой,
			   ряд остаётся по центру по обеим осям. Поля 124 и 70 из макета
			   отдельно не задаются — они следствие центрирования. */
			aspect-ratio: 1160 / 650;
			border-radius: var(--radius-media);
			background-color: var(--color-surface-raised);
		}

		.screens-panel__row {
			height: 100%;
			gap: 6.897%; /* 80 / 1160 */
		}

		.screens-panel__screen {
			flex: 0 0 21.638%; /* 251 / 1160 */
			max-width: none;
		}
	}
</style>
