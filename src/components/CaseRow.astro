---
/*
 * CaseRow — DESIGN.md §3 «Компоненты» + «Блоки главной» №3 + карточка P5-T2.
 * Раскладка переписана 11.08.2026 по плану PLAN-FIGMA-HERO-CASE-2026-08-11.md,
 * задача Т5, раздел 2 «Блок кейса» (узел 381:14548). Применяется к обеим
 * карточкам ленты (подтверждено архитектором: «это CaseRow целиком»).
 *
 * Весь блок кейса — ОДНА ссылка на /works/<slug>: кликабельны заголовок,
 * подзаголовок, кнопка-приманка и медиа. Здесь ровно один <a>, оборачивающий
 * всё содержимое строки. Кнопка «Подробнее о проекте» — не второй <a> (это
 * сделало бы вложенную ссылку, невалидный HTML), а <span>: визуально кнопка,
 * фактически часть текста единственной ссылки блока.
 *
 * Год убран из блока (план, раздел 2: в таблице дельты строки «год» нет;
 * подтверждено архитектором — кнопка заняла его прежнее место в правом
 * верхнем углу). Токен --text-year-* остаётся в tokens.css: используется
 * на странице кейса (case-page__meta), туда план не заходит.
 *
 * Заголовок кейса — <h3> (после будущих H1/H2 героя иерархия не
 * прерывается). Подзаголовок — <p>. Кнопка размечена как обычный текст
 * внутри ссылки, не как интерактивный элемент: у неё нет отдельного фокуса,
 * весь фокус остаётся на .case-row__link — так же, как было с текстом
 * года раньше.
 *
 * P11-T5: data-reveal на <li> целиком — «каждый кейс» в перечне DESIGN.md
 * §4 считается одним блоком, а не набором из заголовка/подзаголовка/медиа
 * с внутренней лесенкой: строки и так растянуты по странице и попадают
 * в зону видимости по очереди по мере скролла, искусственная задержка
 * между их собственными полями не нужна (лесенка 90 мс — приём для полей
 * внутри одного одновременно видимого блока, как в Hero, а не для списка).
 */
import type { CollectionEntry } from 'astro:content';
import CaseMedia from './CaseMedia.astro';
import { withBase } from '../lib/url';

interface Props {
	work: CollectionEntry<'works'>;
	/** Первая строка ленты — медиа не уходит в loading="lazy" (DESIGN.md §6). */
	eager?: boolean;
}

const { work, eager = false } = Astro.props;
const { title, summary, video, poster } = work.data;
const href = withBase(`works/${work.id}/`);
const arrowIcon = withBase('media/icons/arrow-up-bold.svg');
---

<li class="case-row" data-reveal data-snap>
	<a class="case-row__link case-block-width" href={href}>
		<div class="case-row__header">
			<div class="case-row__text">
				<h3 class="case-row__title">{title}</h3>
				<p class="case-row__subtitle">{summary}</p>
			</div>
			<span class="case-row__cta">
				Подробнее о проекте
				<img class="case-row__cta-icon" src={arrowIcon} alt="" width="24" height="24" />
			</span>
		</div>
		<CaseMedia video={video} poster={poster} alt={`Превью кейса «${title}»`} eager={eager} />
	</a>
</li>

<style>
	/* PLAN-PATCH-2026-08-11.md, B2: шапка больше не липкая (position: sticky
	   снят в Header.astro), поэтому этот отступ — не высота шапки
	   (--space-sticky-header), а собственное верхнее поле блока: в макете
	   от верха блока до верха заголовка 64px, токен --space-case-row-top
	   (tokens.css). Та же величина вычитается в формуле .case-block-width
	   (layout.css) — это одна и та же 64px-константа, использованная дважды. */
	.case-row {
		padding-top: var(--space-case-row-top);
	}

	.case-row__link {
		display: block;
		color: inherit;
	}

	/* Отменяет глобальное a:hover/:focus-visible { text-decoration: underline }
	   из typography.css — DESIGN.md §4 «Строка кейса» задаёт для hover
	   подсветку заголовка, а не подчёркивание всего блока. */
	.case-row__link:hover,
	.case-row__link:focus-visible {
		text-decoration: none;
	}

	.case-row__link:focus-visible {
		outline: 2px solid var(--color-text); /* DESIGN.md §7: видимый фокус на строках кейсов */
		outline-offset: 4px;
		border-radius: var(--radius-media);
	}

	/* Колонка по умолчанию, строка с 600px — та же точка, что была у пары
	   «заголовок/год», план мобильную раскладку кнопки не описывает
	   (блокер Б-2 плана), новый брейкпоинт не заводился. */
	.case-row__header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: calc(var(--space-unit) * 4); /* не задано планом — инженерный дефолт на базовой единице, как и раньше */
	}

	.case-row__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-case-row-title-to-subtitle);
		min-width: 0; /* заголовок и подзаголовок сжимаются раньше кнопки */
	}

	.case-row__title {
		font-family: var(--font-display);
		font-size: var(--text-case-title-size);
		line-height: var(--text-case-title-line-height);
		/* 500 «Medium» — план Т5, узел 381:14526. Не общий
		   --text-case-title-weight (700): та же роль ещё используется
		   на h2 странице кейса, план её не трогает. */
		font-weight: 500;
		transition: color 250ms ease-out; /* DESIGN.md §4 «Строка кейса»: hover 250мс ease-out */
	}

	.case-row__link:hover .case-row__title,
	.case-row__link:focus-visible .case-row__title {
		color: var(--color-text-muted); /* DESIGN.md §4: подсветка заголовка */
	}

	.case-row__subtitle {
		max-width: none; /* переопределение typography.css: 66ch — норма для связного текста, здесь короткая подпись в 1–2 строки */
		font-family: var(--font-body);
		font-size: var(--text-case-row-subtitle-size);
		line-height: var(--text-case-row-subtitle-line-height);
		font-weight: var(--text-case-subtitle-weight);
		color: var(--color-text-subtle);
	}

	/* Кнопка-приманка «Подробнее о проекте» — план Т5, узел 381:14523.
	   Стиль красной кнопки героя («Связаться»), подтверждено архитектором:
	   своего цвета план для этой кнопки не давал. <span>, не <a> — весь
	   блок уже одна ссылка, вложенная ссылка была бы невалидным HTML. */
	.case-row__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		gap: calc(var(--space-unit) * 1); /* 4px — план: «зазор 4 от текста» */
		height: var(--size-header-control);
		padding-inline: var(--space-header-button-padding);
		border-radius: var(--radius-pill-full);
		font-family: var(--font-body);
		font-size: var(--text-header-button-size);
		font-weight: var(--text-button-weight); /* 600 — план А4: типографика кнопок из героя, не из фреймов состояний */
		line-height: 1;
		white-space: nowrap;
		background-color: var(--color-red);
		color: var(--color-bg);
		box-shadow: var(--shadow-button-solid);
		transition: background-color 150ms ease-out;
	}

	.case-row__link:hover .case-row__cta {
		background-color: var(--color-red-hover);
	}

	.case-row__link:active .case-row__cta {
		background-color: var(--color-red-active);
	}

	.case-row__cta-icon {
		flex-shrink: 0; /* reset.css: svg/img как флекс-элемент иначе сжимается до нуля */
		transform: rotate(90deg); /* план: стрелка повёрнута на 90° вправо */
	}

	.case-row :global(.case-media) {
		margin-top: var(--space-case-row-subtitle-to-media);
		/* 1280×648 — план Т5, отличается от общего 5:4 (--radius-media
		   уже 32 глобально из Т1). Только эта карточка: страницу кейса
		   план не трогает, там .case-media остаётся на 5:4. */
		aspect-ratio: 1280 / 648;
	}

	@media (min-width: 600px) {
		.case-row__header {
			flex-direction: row;
			align-items: flex-start;
			justify-content: space-between;
		}
	}
</style>
