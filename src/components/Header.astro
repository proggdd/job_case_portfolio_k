---
/*
 * Шапка — геометрия по коду макета из Figma (09.08.2026, узел 381:14535/
 * 381:14543), состояния кнопок — план PLAN-FIGMA-HERO-CASE-2026-08-11.md,
 * задача Т4, узлы 381:14420 («Резюме») и 381:14429 («Связаться»).
 *
 * Аватар 56×56 на отметке 60px от верха, поле по бокам 80px, две кнопки
 * высотой 56 с полем 24 по горизонтали, радиусом 100 и зазором 16,
 * текст 24/500.
 *
 * ── Кнопки переименованы и перекрашены 11.08.2026 ────────────────────────
 * Было: «Контакты» (чёрная) и «Резюме» (белая с обводкой) — цвета
 * оставались от решения заказчика 09.08 «цвета оставь как были». План
 * 11.08 вводит вторую кнопку узлом «Связаться» — впервые в проекте
 * появляется красный (--color-accent из tokens.css). «Связаться» по-прежнему
 * ведёт в телеграм. «Резюме» 11.08.2026 (C9) стала вкладкой без ссылки —
 * файла резюме ещё нет, подробности у стилей .header-button--disabled ниже.
 *
 * ── Шесть состояний вместо дефолтных ──────────────────────────────────────
 * Обе кнопки получили hover/active по таблице плана (раздел 2, «Состояния
 * кнопок»): у «Резюме» это заливка на наведении/нажатии, у «Связаться» —
 * три оттенка красного. Разночтение шрифта фреймов состояний (план,
 * раздел 2) решено по указанию плана: цвета и тени — из фреймов состояний,
 * типографика — из героя (var(--font-body), --text-header-button-size).
 *
 * ── Стекло убрано ────────────────────────────────────────────────────────
 * Матового стекла (--glass-*) в шапке больше нет: в референсе плоские
 * кнопки на белом с волосяной тенью, а у аватара нет кольца. Токены
 * --glass-* остаются в проекте — на них стоит волосяная граница медиа
 * кейса (layout.css).
 *
 * ── Обводка через inset box-shadow, не border ────────────────────────────
 * В макете это outline с offset -1.5, то есть линия внутри и без влияния
 * на размер. border: 1.5px при box-sizing: border-box съел бы высоту
 * и поля кнопки. inset-тень даёт ту же линию и не трогает раскладку,
 * а свойство outline остаётся свободным для видимого фокуса.
 *
 * ── :focus-visible ────────────────────────────────────────────────────────
 * В макете фокуса нет (план, Т4: «без него кнопка недоступна с клавиатуры»,
 * значение поручено согласовать с архитектором отдельно). До ответа
 * переиспользован тот же контур, что уже стоял на этих кнопках и стоит
 * на пилюлях и строках кейсов по всему сайту (DESIGN.md §7) — не новое
 * придуманное значение, а существующая договорённость проекта.
 *
 * Аватар-кружок цветной (grayscale снят 09.08 решением заказчика).
 *
 * ── Видео вместо статичной фотографии, 11.08.2026 ────────────────────────
 * PLAN-PATCH-2026-08-11.md, B1. Заказчик: видео в кружке шапки вместо
 * фотографии — отдельный анимированный портрет, к 3D-голове героя
 * отношения не имеет (её не трогать, правило раздела 5 плана).
 *
 * Разметка и приём — те же, что в Hero.astro: статичный <img>-постер
 * и <video> поверх него, видимость переключает JS через data-active
 * после первого декодированного кадра. `autoplay muted loop playsinline`
 * стоят на <video> как обычные HTML-атрибуты — без muted и playsinline
 * автозапуск не пройдёт ни в одном браузере, но сработают они только
 * после того, как скрипт ниже проставит настоящий src (изначально
 * в разметке только data-src) — так видео не запрашивается сетью
 * вообще, если !prefers-reduced-motion не выполнено.
 *
 * Пауза, когда кружок не виден. Ролик крутится на каждой странице всё
 * время, пока открыта вкладка, и ест батарею ради 56 пикселей в углу.
 * IntersectionObserver здесь работает не один раз (как в Hero, где он
 * только триггерит загрузку и отключается), а постоянно переключает
 * play/pause на каждое пересечение — сам приём наблюдения переиспользован,
 * логика подписки достроена под многократное срабатывание. Плюс
 * document.visibilitychange — пауза в фоновой вкладке.
 */
import MorphIcon from 'morphicons/astro';
import { Menu } from 'lucide';
import { contacts } from '../data/contacts.ts';
import { withBase } from '../lib/url';

const telegram = contacts.find((contact) => contact.icon === 'telegram');

const avatarPoster = withBase('media/header/portrait-poster.webp');
const avatarVideo = withBase('media/header/portrait-loop.mp4');
---

<header class="site-header" data-header>
	<div class="site-header__inner">
		<div class="avatar-media" data-avatar-media>
			<img class="avatar avatar__poster" src={avatarPoster} alt="" aria-hidden="true" width="168" height="168" />
			<video
				class="avatar avatar__video"
				data-avatar-video
				data-src={avatarVideo}
				poster={avatarPoster}
				autoplay
				muted
				loop
				playsinline
				aria-hidden="true"
				tabindex="-1"
				width="168"
				height="168"></video>
		</div>

		<nav class="site-header__actions" aria-label="Связаться">
			<span class="header-button header-button--outline header-button--disabled">Резюме</span>
			{telegram && (
				<a class="header-button header-button--solid" href={telegram.href} target="_blank" rel="noopener noreferrer">
					Связаться
					<span class="visually-hidden">, Телеграм (откроется в новом окне)</span>
				</a>
			)}
		</nav>

		{/*
		 * Кнопка-бургер — патч T4, только мобильная раскладка (<768px).
		 * Разметка согласована с заказчиком (патч §4 Т2). Добавлены два
		 * атрибута MorphIcon: size={28} — компромисс 28×19.73/32×32 из §4 Т4;
		 * reducedMotion="user" — иначе morphicons по умолчанию "never"
		 * и игнорирует системный prefers-reduced-motion (критерий §4 Т4).
		 */}
		<button id="menu" type="button" aria-label="Toggle menu" aria-expanded="false">
			<MorphIcon icon={Menu} size={28} reducedMotion="user" />
		</button>
	</div>

	{/*
	 * Панель мобильного меню — патч T4 Т3. Числа из выгрузки Figma
	 * css_571-5444: панель 393×553 фоном --color-text от верха экрана
	 * (Rectangle 240661925), два пункта 393×48 на y=64 и y=112, фото
	 * в боксе 361×351 на x=16 y=178 со скруглением медиа (Mask group).
	 * «Резюме» — <span> без ссылки, как в шапке (файла резюме нет, C9);
	 * куда ведёт пункт — открытый вопрос патча §6. «Связаться» — тот же
	 * телеграм, что у кнопки шапки.
	 */}
	<nav id="menu-panel" class="menu-panel" aria-label="Меню" hidden>
		<span class="menu-panel__item menu-panel__item--disabled">Резюме</span>
		{telegram && (
			<a class="menu-panel__item" href={telegram.href} target="_blank" rel="noopener noreferrer">
				Связаться
				<span class="visually-hidden">, Телеграм (откроется в новом окне)</span>
			</a>
		)}
		<div class="menu-panel__photo">
			<img src={withBase('media/menu/menu-photo.webp')} alt="" width="722" height="702" loading="lazy" />
		</div>
	</nav>
</header>

<style>
	/*
	 * PLAN-PATCH-2026-08-11.md, B2: заказчик попросил убрать «движущуюся»
	 * шапку — position: sticky снят, шапка остаётся первым элементом
	 * в потоке и уезжает вместе со страницей. Фон остаётся прозрачным:
	 * по макету верх постера героя (86px) ниже верха кнопок (60px),
	 * шапка по-прежнему визуально «плавает» над первым экраном за счёт
	 * отрицательного отступа героя (Hero.astro, ≥1024px) — это осталось
	 * не связано со sticky.
	 *
	 * Поля снизу нет намеренно — нижняя граница шапки совпадает с нижним
	 * краем кнопок. --space-sticky-header (её полная высота) больше не
	 * определяет отступы блоков кейсов (см. --space-case-row-top,
	 * tokens.css), но токен остаётся: на нём стоит отрицательный отступ
	 * героя (Hero.astro) и header-sentinel (Base.astro).
	 */
	.site-header {
		/* position: relative обязателен — z-index на статичном элементе не
		   действует. Без него шапка проигрывала стек позиционированному
		   .hero__media (position: relative) и герой перекрывал кнопки
		   на любом экране, где они визуально пересекаются (≥1024px). */
		position: relative;
		z-index: 10;
		background-color: transparent;
		padding-top: var(--space-header-top);
	}

	/*
	 * Свой контейнер вместо .container. До C6 (PLAN-C-HERO-FONTS-2026-08-11.md)
	 * поле шапки было 80px против 50px у остальной страницы, отсюда и
	 * раздельный контейнер. C6 свёл оба поля к одному значению
	 * (--space-header-side теперь ссылается на --space-content-padding,
	 * оба 80px) — разделение осталось на десктопе как есть, менять не
	 * просили, но числа теперь совпадают. Мобильная и планшетная ступени
	 * те же, что в layout.css (20 и 32) — про них референс ничего не говорит.
	 */
	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-header-gap);
		width: 100%;
		margin-inline: auto;
		padding-inline: 20px;
	}

	@media (min-width: 600px) {
		.site-header__inner {
			padding-inline: 32px;
		}
	}

	@media (min-width: 1024px) {
		.site-header__inner {
			max-width: 1440px; /* макет 1440: 1440 - 2×80 даёт контент 1280 */
			padding-inline: var(--space-header-side);
		}
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: var(--space-header-gap);
	}

	.avatar-media {
		position: relative;
		width: var(--size-header-control);
		height: var(--size-header-control);
		flex-shrink: 0;
	}

	/* Круглая маска остаётся: DESIGN.md §2 сняла её только с героя. */
	.avatar {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
		background-color: var(--color-surface); /* фон под загрузку файла */
	}

	.avatar__video {
		position: absolute;
		inset: 0;
		visibility: hidden; /* показывается скриптом, только если видео действительно загрузилось */
	}

	@media (prefers-reduced-motion: reduce) {
		.avatar__video {
			display: none; /* скрипт и так не грузит видео при reduced motion */
		}
	}

	.avatar-media[data-active='true'] .avatar__video {
		visibility: visible;
	}

	.avatar-media[data-active='true'] .avatar__poster {
		visibility: hidden;
	}

	.header-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: var(--size-header-control);
		padding-inline: var(--space-header-button-padding);
		border-radius: var(--radius-pill-full);
		font-family: var(--font-body);
		font-size: var(--text-header-button-size);
		font-weight: var(--text-button-weight); /* 600 — план А4: типографика кнопок из героя, не из фреймов состояний */
		line-height: 1;
		white-space: nowrap;
		/*
		 * B4: смена цвета при нажатии не читалась. Диагноз обратный
		 * формулировке заказчика («слишком быстро меняется») — переход был
		 * симметричным 150мс, а :active живёт 80-120мс при обычном клике:
		 * анимация не успевала доехать до тёмного цвета и разворачивалась
		 * обратно, поэтому нажатие не читалось вообще.
		 *
		 * Асимметричный тайминг лечит это: вход в нажатие ниже мгновенный
		 * (transition-duration: 0ms на :active), возврат — эта строка,
		 * 180мс. ease, не ease-out: это смена цвета в покое/наведении,
		 * а не появление/исчезновение элемента (skill `animate`, таблица
		 * кривых). 180мс — внутри диапазона «кнопка, обратная связь»
		 * (100-160мс) и общего потолка UI-переходов (300мс), проверено
		 * живым кликом на превью.
		 */
		transition: background-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
	}

	.header-button:active {
		transition-duration: 0ms; /* мгновенный вход в нажатие — само нажатие остаётся видимым при любой длительности клика */
	}

	@media (prefers-reduced-motion: reduce) {
		.header-button {
			transition-duration: 0ms;
		}
	}

	/* «Резюме» — вторичная, с обводкой. План Т4, узел 381:14420.
	   #121212 макета переиспользует --color-text (tokens.css, «Решение
	   по #121212») — второй почти-чёрный ради 3/255 разницы неоправдан. */
	.header-button--outline {
		background-color: transparent;
		color: var(--color-text);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-outline);
	}

	.header-button--outline:hover {
		background-color: var(--color-text);
		color: var(--color-bg);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-solid);
	}

	.header-button--outline:active {
		background-color: var(--color-button-outline-active);
		color: var(--color-bg);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-outline);
	}

	/*
	 * C9 (PLAN-C-HERO-FONTS-2026-08-11.md). «Резюме» временно без файла —
	 * заказчик: «с резюме тоже потом, воткнём пока вкладку просто с
	 * подписью резюме в том же стиле». <span>, не <a href="#">: ссылка,
	 * которая никуда не ведёт, обманывает скринридер. :focus-visible
	 * не нужен отдельно: <span> без tabindex не попадает в таб-порядок.
	 *
	 * Правка 11.08.2026 по замечанию заказчика «кнопку резюме совсем
	 * убили, а я просил вкладку-заглушку». Первая редакция C9 гасила
	 * ещё и hover/active — вкладка переставала отзываться на мышь
	 * и читалась как сломанная. Отклик возвращён: заглушка должна
	 * выглядеть живой вкладкой, у которой пока нет адреса, а не
	 * выключенным элементом. Наследует hover/active от
	 * .header-button--outline, своих состояний не заводит.
	 *
	 * Курсор остаётся стрелкой: вкладка не кликается, и обещать палец
	 * там, где ничего не произойдёт, — единственное, что здесь
	 * действительно вводило бы в заблуждение. Когда появится файл,
	 * <span> станет <a> и курсор придёт вместе со ссылкой.
	 */
	.header-button--disabled {
		cursor: default;
	}

	/* «Связаться» — основная, красная. План Т4, узел 381:14429. Ведёт
	   в телеграм, как и прежняя чёрная «Контакты». */
	.header-button--solid {
		background-color: var(--color-accent);
		color: var(--color-bg);
		box-shadow: var(--shadow-button-solid);
	}

	.header-button--solid:hover {
		background-color: var(--color-accent-hover);
	}

	.header-button--solid:active {
		background-color: var(--color-accent-active);
	}

	.header-button:hover,
	.header-button:focus-visible {
		text-decoration: none; /* отменяет глобальное подчёркивание ссылок из typography.css */
	}

	.header-button:focus-visible {
		outline: 2px solid var(--color-text); /* DESIGN.md §7: видимый фокус, значение то же, что и раньше на этих кнопках — план Т4 просит согласовать своё, но не даёт числа */
		outline-offset: 2px;
	}

	.header-button--solid:focus-visible {
		outline-offset: 3px; /* обводка не должна сливаться с красной заливкой */
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/*
	 * ─── Мобильная шапка — патч T4, раскладка ниже 768px ──────────────────
	 * Числа из выгрузки Figma css_571-5444 (секция «Мобилка сайта»,
	 * прислана заказчиком 01.09): полоса 393×64 фоном --color-text
	 * (Rectangle 240661932), бокс бургера 48×48 на x=329 y=8 от края 393
	 * (Header/Burger), иконка белая.
	 * Десктоп не трогается: все правки внутри медиазапроса, базовое
	 * правило #menu только гасит кнопку.
	 */
	#menu {
		display: none; /* десктоп: бургера в макете нет */
	}

	.menu-panel {
		display: none; /* десктоп: панели нет, бургер её не открывает */
	}

	/* Тайминг инверсии плашки — тот же 180ms ease, что у .header-button:
	   договорённость проекта, не новое значение (ср. focus-outline выше). */
	@media (prefers-reduced-motion: reduce) {
		.menu-panel__item {
			transition-duration: 0ms;
		}
	}

	@media (max-width: 767.98px) {
		.site-header {
			padding-top: 0; /* полоса от верха экрана, высота ровно 64 */
			background-color: var(--color-text);
		}

		.site-header__inner {
			min-height: 64px; /* аватар и кнопки скрыты — высоту держит полоса */
			padding-inline: 16px; /* бокс 48 на x=329 от края 393 → зазор справа 16 */
			justify-content: flex-end;
		}

		.avatar-media,
		.site-header__actions {
			display: none; /* в мобильном макете их нет; разметка нужна десктопу */
		}

		#menu {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			position: relative;
			z-index: 21; /* над панелью (20) — крестик открытого меню виден и нажимается */
			width: 48px;
			height: 48px;
			padding: 0;
			border: 0;
			background-color: transparent;
			color: var(--color-bg); /* currentColor → белый штрих иконки */
			cursor: pointer;
			flex-shrink: 0;
		}

		#menu:focus-visible {
			outline: 2px solid var(--color-bg);
			outline-offset: 2px;
		}

		.menu-panel {
			display: block;
			position: fixed;
			inset: 0 0 auto 0;
			z-index: 20; /* над полосой шапки (z-index 10) */
			height: 553px;
			max-height: 100dvh;
			padding-top: 64px; /* пункты идут под полосой, y=64 */
			background-color: var(--color-text);
			overflow-y: auto;
		}

		.menu-panel[hidden] {
			display: none;
		}

		.menu-panel__item {
			display: flex;
			align-items: center;
			height: 48px;
			padding-inline: 16px; /* x=16 */
			font-weight: 500;
			font-size: 20px;
			line-height: 1;
			color: var(--color-bg);
			background-color: var(--color-text);
			text-decoration: none;
			white-space: nowrap;
			transition: background-color 180ms ease, color 180ms ease;
		}

		.menu-panel__item--disabled {
			cursor: default; /* «Резюме» пока без адреса — как в шапке (C9) */
		}

		/* Второй кадр макета (Frame 2147225413): наведённая плашка белая,
		   текст тёмный. Фокус — тем же инвертом. */
		.menu-panel__item:hover,
		.menu-panel__item:focus-visible {
			background-color: var(--color-bg);
			color: var(--color-text);
		}

		.menu-panel__photo {
			margin: 18px 16px 0; /* x=16; от конца пункта 2 (y=160) до фото (y=178) */
			width: calc(100% - 32px);
			max-width: 361px; /* бокс 361×351 */
			aspect-ratio: 361 / 351;
			border-radius: var(--radius-media); /* «скругление как у медиа» */
			overflow: hidden;
		}

		.menu-panel__photo img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	}
</style>

<script>
	/*
	 * Видео-портрет в кружке шапки — план B1. Приём загрузки списан с
	 * IntersectionObserver в Hero.astro (там видео тоже не грузится, пока
	 * элемент не показался на экране), но здесь наблюдатель не отключается
	 * после первого срабатывания: ролик должен вставать на паузу каждый раз,
	 * когда кружок уходит за край экрана, не только один раз при заходе.
	 */
	const media = document.querySelector<HTMLElement>('[data-avatar-media]');
	const video = document.querySelector<HTMLVideoElement>('[data-avatar-video]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (media && video && !reducedMotion) {
		const src = video.dataset.src ?? '';

		video.addEventListener(
			'loadeddata',
			() => {
				media.dataset.active = 'true';
			},
			{ once: true }
		);

		// Пауза за экраном: постоянный наблюдатель, не одноразовый — переключает
		// play/pause на каждое пересечение границы вьюпорта.
		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					video.play().catch(() => {});
				} else {
					video.pause();
				}
			}
		});
		observer.observe(media);

		// Пауза в фоновой вкладке: play() при возврате — только если кружок
		// в этот момент действительно виден на экране.
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) {
				video.pause();
				return;
			}
			const rect = media.getBoundingClientRect();
			if (rect.bottom > 0 && rect.top < window.innerHeight) {
				video.play().catch(() => {});
			}
		});

		// src проставляется только теперь: без этого браузер не запросил бы
		// файл вовсе (в разметке — data-src, не src), а атрибут autoplay
		// на <video> подхватывает воспроизведение сам, как только данных
		// достаточно.
		video.src = src;
		video.load();
	}
</script>

<script>
	/*
	 * Мобильное меню — патч T4 Т3. Открытие и закрытие по кнопке #menu,
	 * закрытие по Escape с возвратом фокуса, блокировка прокрутки фона
	 * при открытой панели. Морфинг иконки добавляется в Т4.
	 */
	const menuButton = document.querySelector<HTMLButtonElement>('#menu');
	const menuPanel = document.querySelector<HTMLElement>('#menu-panel');

	if (menuButton && menuPanel) {
		const setMenu = (open: boolean) => {
			menuButton.setAttribute('aria-expanded', String(open));
			menuPanel.hidden = !open;
			document.body.style.overflow = open ? 'hidden' : '';
		};

		menuButton.addEventListener('click', () => {
			setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
				setMenu(false);
				menuButton.focus();
			}
		});
	}
</script>
