---
/*
 * Шапка — DESIGN.md §3, блок 1.
 *
 * ── Раскладка, пересмотрена 09.08.2026 ───────────────────────────────────
 * Панель контактов уехала из центра к правому краю по решению заказчика:
 * «смести шапку по правому краю, там как раз пусто, не будет мешать
 * просмотру карточек». Центр — единственное место, где плавающая шапка
 * перекрывала медиа кейса; справа от карточки поле пустое на всех ширинах,
 * потому что .case-block-width уже колонки (замер 09.08: 939 против 1436).
 * Аватар остаётся слева: он и раньше стоял у края и обзору не мешал.
 *
 * ── Два состояния панели ─────────────────────────────────────────────────
 * Наверху страницы: три значка без подписей (ContactPills в режиме iconsOnly).
 * Ниже первого экрана: панель сворачивается в кнопку «Контакты» со значком
 * чата, мельче и легче начертанием (--text-pill-compact-*). При наведении
 * или заходе с клавиатуры — снова разворачивается в три значка.
 *
 * Разворот наружу влево от правого края: обе капсулы прижаты к правому краю
 * (right: 0), поэтому растёт панель в сторону свободного места, а не за край
 * экрана.
 *
 * Свёрнутая и развёрнутая капсулы обе остаются в DOM. Скрытая уводится
 * через opacity + pointer-events, а не display: none — иначе ссылки внутри
 * выпадали бы из порядка обхода табом, и панель нельзя было бы развернуть
 * с клавиатуры. :focus-within на обёртке раскрывает её при заходе табом.
 *
 * is-compact вернулся после отмены 09.08 (тогда убирали укрупнение шапки на
 * первом экране). Смысл у класса теперь другой: не «уменьшить всё», а
 * «свернуть панель в кнопку». Размеры капсул при этом одинаковые в обоих
 * состояниях — то, что заказчик просил в прошлый раз, не отменяется.
 *
 * is-hidden (исчезновение у подвала) не тронут.
 */
import ContactPills from './ContactPills.astro';
import { withBase } from '../lib/url';
---

<header class="site-header" data-header>
	<div class="site-header__inner container">
		<div class="avatar-glass">
			<img class="avatar" src={withBase('media/avatar/head-poster.webp')} alt="" aria-hidden="true" width="1240" height="1240" />
		</div>

		<div class="contact-panel">
			<span class="contact-panel__toggle" aria-hidden="true">
				<svg width="20" height="20" viewBox="0 0 24 24" focusable="false">
					<path
						d="M3 6.5A2 2 0 0 1 5 4.5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8l-5 4v-4H5a2 2 0 0 1-2-2z"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				<span class="contact-panel__toggle-label">Контакты</span>
			</span>

			<div class="pill-group">
				<ContactPills iconsOnly />
			</div>
		</div>

		<a class="contacts-link" href={withBase('contacts/')}>
			<span>Контакты</span>
			<svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
				<path
					d="M4 12L12 4M8 4H12V8"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const sentinel = document.querySelector<HTMLElement>('[data-viewport-sentinel]');
	const footer = document.querySelector<HTMLElement>('[data-footer]');

	if (header && sentinel) {
		// панель сворачивается, когда сентинел высотой в экран ушёл из вида —
		// то есть пролистали дальше первого экрана (DESIGN.md §3: наблюдатель,
		// а не обработчик scroll)
		const compactObserver = new IntersectionObserver(([entry]) => {
			header.classList.toggle('is-compact', !entry.isIntersecting);
		});
		compactObserver.observe(sentinel);
	}

	if (header && footer) {
		// исчезновение у подвала: показался подвал — прячем шапку, ушёл из вида — возвращаем
		const footerObserver = new IntersectionObserver(([entry]) => {
			header.classList.toggle('is-hidden', entry.isIntersecting);
		});
		footerObserver.observe(footer);
	}
</script>

<style>
	/*
	 * Фон самой шапки прозрачный, стекло — на отдельных капсулах: аватар слева
	 * и панель контактов справа (правка 05.08.2026, раскладка — 09.08.2026).
	 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: transparent;
		padding-block: calc(var(--space-header-to-hero) / 2);
		transform: translateY(0);
		transition: transform 300ms ease-out; /* DESIGN.md §4: 300 мс ease-out */
	}

	/* Исчезновение у подвала — уезжает вверх за пределы экрана. */
	.site-header.is-hidden {
		transform: translateY(-100%);
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			transition: none; /* DESIGN.md §4: состояния переключаются мгновенно */
		}
	}

	/* Аватар слева, панель контактов справа. Средней колонки больше нет:
	   панель прижата к правому краю, центрировать нечего. */
	.site-header__inner {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
	}

	/*
	 * Матовое стекло — общий вид капсул (токены в tokens.css).
	 *
	 * Правка 08.08.2026. Здесь стояла пара объявлений: стандартное
	 * backdrop-filter и следом -webkit-backdrop-filter «для Safari».
	 * Минификатор счёл их дублем одного свойства и оставил в собранном CSS
	 * только вторую, префиксную строку. Chrome алиас -webkit-backdrop-filter
	 * больше не поддерживает (CSS.supports вернул false на живом сайте),
	 * поэтому стекло не отрисовывалось нигде: getComputedStyle отдавал
	 * backdrop-filter: none при корректном коде компонента.
	 * Префиксную строку убрали: Safari работает без префикса с 18-й версии,
	 * префикс был нужен для 15.4. Одно объявление минификатору не с чем
	 * склеивать. Проверка после сборки — grep по dist/_astro/*.css: должно
	 * найтись backdrop-filter без префикса.
	 */
	.avatar-glass,
	.pill-group,
	.contact-panel__toggle,
	.contacts-link {
		background-color: var(--glass-bg);
		border: 1px solid var(--glass-border);
		box-shadow: var(--glass-shadow);
		backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
	}

	/* Окантовка аватара: тонкое кольцо вокруг круга. */
	.avatar-glass {
		justify-self: start;
		padding: 6px;
		border-radius: 50%;
		line-height: 0;
	}

	/* Правка 09.08.2026: здесь стояла пустая заглушка --color-surface (серый
	   круг на скриншотах заказчика). Подставлен постер аватара — тот же файл,
	   что и в герое. Чёрно-белый фильтр — DESIGN.md §2 «Прочее»: «фото аватара
	   в шапке чёрно-белое, фото в герое цветное». Круглая маска здесь
	   остаётся: DESIGN.md §2 снял её только с героя. */
	.avatar {
		display: block;
		width: 52px;
		height: 52px;
		border-radius: 50%; /* DESIGN.md §2 «Скругления»: аватар-миниатюра — круг */
		object-fit: cover;
		filter: grayscale(1); /* DESIGN.md §2 «Прочее» */
		background-color: var(--color-surface); /* фон под загрузку файла */
	}

	/* Обёртка двух состояний. Высота задана явно, чтобы строка шапки не
	   дёргалась при переключении: обе капсулы одной высоты. */
	.contact-panel {
		position: relative;
		justify-self: end;
		height: 52px;
	}

	.pill-group,
	.contact-panel__toggle {
		position: absolute;
		top: 0;
		right: 0; /* обе капсулы прижаты к правому краю — панель растёт влево, в пустое поле */
		height: 52px;
		border-radius: var(--radius-pill-group); /* DESIGN.md §2: 24px */
		transition:
			opacity 300ms ease-out,
			transform 300ms ease-out; /* DESIGN.md §4: 300 мс ease-out */
	}

	.pill-group {
		display: flex;
		align-items: center;
		/* 12px — внутренний боковой отступ подложки не задан в DESIGN.md, инженерный дефолт */
		padding-inline: calc(var(--space-unit) * 3);
	}

	.contact-panel__toggle {
		display: inline-flex;
		align-items: center;
		gap: calc(var(--space-unit) * 2);
		padding-inline: calc(var(--space-unit) * 5);
		font-family: var(--font-body);
		font-size: var(--text-pill-compact-size);
		font-weight: var(--text-pill-compact-weight);
		color: var(--color-text);
		white-space: nowrap;
	}

	/* Наверху страницы: видны три значка, свёрнутая кнопка спрятана. */
	.contact-panel__toggle {
		opacity: 0;
		pointer-events: none;
	}

	/* Ниже первого экрана: панель свёрнута в кнопку. Значки уводятся
	   прозрачностью, а не display: none — иначе ссылки выпали бы из обхода
	   табом и панель нельзя было бы раскрыть с клавиатуры. */
	.site-header.is-compact .contact-panel__toggle {
		opacity: 1;
		pointer-events: auto;
	}

	.site-header.is-compact .pill-group {
		opacity: 0;
		pointer-events: none;
		transform: scale(0.96);
		transform-origin: right center;
	}

	/* Наведение или заход с клавиатуры на свёрнутую панель — снова три значка. */
	.site-header.is-compact .contact-panel:hover .pill-group,
	.site-header.is-compact .contact-panel:focus-within .pill-group {
		opacity: 1;
		pointer-events: auto;
		transform: scale(1);
	}

	.site-header.is-compact .contact-panel:hover .contact-panel__toggle,
	.site-header.is-compact .contact-panel:focus-within .contact-panel__toggle {
		opacity: 0;
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.pill-group,
		.contact-panel__toggle {
			transition: none; /* DESIGN.md §4 */
		}
	}

	/* Мобильная замена панели: одна кнопка, ведущая на страницу контактов.
	   Причина — на 375px группа не помещается рядом с аватаром
	   (правка 05.08.2026, DESIGN.md §3). */
	.contacts-link {
		display: none;
		align-items: center;
		gap: 4px;
		height: 52px;
		padding-inline: calc(var(--space-unit) * 5);
		border-radius: var(--radius-pill-group);
		font-family: var(--font-body);
		font-size: var(--text-pill-compact-size);
		font-weight: var(--text-pill-compact-weight);
		color: var(--color-text);
		text-decoration: none;
	}

	.contacts-link:hover,
	.contacts-link:focus-visible {
		text-decoration: none;
	}

	.contacts-link:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 2px;
	}

	@media (max-width: 599px) {
		.contact-panel {
			display: none;
		}

		.contacts-link {
			display: inline-flex;
			justify-self: end;
		}
	}
</style>
