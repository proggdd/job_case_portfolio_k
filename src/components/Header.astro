---
/*
 * Шапка — геометрия по коду макета из Figma (09.08.2026, узел 381:14535/
 * 381:14543), состояния кнопок — план PLAN-FIGMA-HERO-CASE-2026-08-11.md,
 * задача Т4, узлы 381:14420 («Резюме») и 381:14429 («Связаться»).
 *
 * Аватар 56×56 на отметке 60px от верха, поле по бокам 80px, две кнопки
 * высотой 56 с полем 24 по горизонтали, радиусом 100 и зазором 16,
 * текст 24/500.
 *
 * ── Кнопки переименованы и перекрашены 11.08.2026 ────────────────────────
 * Было: «Контакты» (чёрная) и «Резюме» (белая с обводкой) — цвета
 * оставались от решения заказчика 09.08 «цвета оставь как были». План
 * 11.08 вводит вторую кнопку узлом «Связаться» — впервые в проекте
 * появляется красный (--color-red из tokens.css). Ссылка и назначение
 * не изменились: «Связаться» по-прежнему ведёт в телеграм, «Резюме»
 * по-прежнему открывает файл резюме.
 *
 * ── Шесть состояний вместо дефолтных ──────────────────────────────────────
 * Обе кнопки получили hover/active по таблице плана (раздел 2, «Состояния
 * кнопок»): у «Резюме» это заливка на наведении/нажатии, у «Связаться» —
 * три оттенка красного. Разночтение шрифта фреймов состояний (план,
 * раздел 2) решено по указанию плана: цвета и тени — из фреймов состояний,
 * типографика — из героя (var(--font-body), --text-header-button-size).
 *
 * ── Стекло убрано ────────────────────────────────────────────────────────
 * Матового стекла (--glass-*) в шапке больше нет: в референсе плоские
 * кнопки на белом с волосяной тенью, а у аватара нет кольца. Токены
 * --glass-* остаются в проекте — на них стоит волосяная граница медиа
 * кейса (layout.css).
 *
 * ── Обводка через inset box-shadow, не border ────────────────────────────
 * В макете это outline с offset -1.5, то есть линия внутри и без влияния
 * на размер. border: 1.5px при box-sizing: border-box съел бы высоту
 * и поля кнопки. inset-тень даёт ту же линию и не трогает раскладку,
 * а свойство outline остаётся свободным для видимого фокуса.
 *
 * ── :focus-visible ────────────────────────────────────────────────────────
 * В макете фокуса нет (план, Т4: «без него кнопка недоступна с клавиатуры»,
 * значение поручено согласовать с архитектором отдельно). До ответа
 * переиспользован тот же контур, что уже стоял на этих кнопках и стоит
 * на пилюлях и строках кейсов по всему сайту (DESIGN.md §7) — не новое
 * придуманное значение, а существующая договорённость проекта.
 *
 * Аватар-кружок цветной (grayscale снят 09.08 решением заказчика).
 */
import { contacts } from '../data/contacts.ts';
import { withBase } from '../lib/url';

const telegram = contacts.find((contact) => contact.icon === 'telegram');
const resume = contacts.find((contact) => contact.icon === 'resume');
---

<header class="site-header" data-header>
	<div class="site-header__inner">
		<img
			class="avatar"
			src={withBase('media/avatar/head-thumb.webp')}
			alt=""
			aria-hidden="true"
			width="256"
			height="256"
		/>

		<nav class="site-header__actions" aria-label="Связаться">
			{resume && (
				<a class="header-button header-button--outline" href={resume.href} target="_blank" rel="noopener noreferrer">
					Резюме
					<span class="visually-hidden">(откроется в новом окне)</span>
				</a>
			)}
			{telegram && (
				<a class="header-button header-button--solid" href={telegram.href} target="_blank" rel="noopener noreferrer">
					Связаться
					<span class="visually-hidden">, Телеграм (откроется в новом окне)</span>
				</a>
			)}
		</nav>
	</div>
</header>

<style>
	/*
	 * Фон шапки прозрачный: она плавает над первым экраном, где по макету
	 * верх аватара героя (40px) выше верха кнопок (60px).
	 *
	 * Поля снизу нет намеренно — нижняя граница шапки совпадает с нижним
	 * краем кнопок, и на этом стоит --space-sticky-header, от которого
	 * считаются отступы блоков кейсов.
	 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: transparent;
		padding-top: var(--space-header-top);
	}

	/*
	 * Свой контейнер вместо .container: в макете поле шапки 80px против
	 * 50px у остальной страницы. Мобильная и планшетная ступени те же,
	 * что в layout.css (20 и 32) — про них референс ничего не говорит.
	 */
	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-header-gap);
		width: 100%;
		margin-inline: auto;
		padding-inline: 20px;
	}

	@media (min-width: 600px) {
		.site-header__inner {
			padding-inline: 32px;
		}
	}

	@media (min-width: 1024px) {
		.site-header__inner {
			max-width: 1440px; /* макет 1440: 1440 - 2×80 даёт контент 1280 */
			padding-inline: var(--space-header-side);
		}
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: var(--space-header-gap);
	}

	/* Фото заказчика, обрезанное по голове (head-thumb.webp, 256px — запас
	   почти шестикратный к показываемым 44). Круглая маска остаётся:
	   DESIGN.md §2 сняла её только с героя. */
	.avatar {
		display: block;
		width: var(--size-header-control);
		height: var(--size-header-control);
		border-radius: 50%;
		object-fit: cover;
		background-color: var(--color-surface); /* фон под загрузку файла */
	}

	.header-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: var(--size-header-control);
		padding-inline: var(--space-header-button-padding);
		border-radius: var(--radius-pill-full);
		font-family: var(--font-body);
		font-size: var(--text-header-button-size);
		font-weight: var(--text-pill-weight); /* 500 «среднее», как в макете */
		line-height: 1;
		white-space: nowrap;
		transition: background-color 150ms ease-out, color 150ms ease-out, box-shadow 150ms ease-out;
	}

	/* «Резюме» — вторичная, с обводкой. План Т4, узел 381:14420.
	   #121212 макета переиспользует --color-text (tokens.css, «Решение
	   по #121212») — второй почти-чёрный ради 3/255 разницы неоправдан. */
	.header-button--outline {
		background-color: transparent;
		color: var(--color-text);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-outline);
	}

	.header-button--outline:hover {
		background-color: var(--color-text);
		color: var(--color-bg);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-solid);
	}

	.header-button--outline:active {
		background-color: var(--color-button-outline-active);
		color: var(--color-bg);
		box-shadow:
			inset 0 0 0 1.5px var(--color-text),
			var(--shadow-button-outline);
	}

	/* «Связаться» — основная, красная. План Т4, узел 381:14429. Ведёт
	   в телеграм, как и прежняя чёрная «Контакты». */
	.header-button--solid {
		background-color: var(--color-red);
		color: var(--color-bg);
		box-shadow: var(--shadow-button-solid);
	}

	.header-button--solid:hover {
		background-color: var(--color-red-hover);
	}

	.header-button--solid:active {
		background-color: var(--color-red-active);
	}

	.header-button:hover,
	.header-button:focus-visible {
		text-decoration: none; /* отменяет глобальное подчёркивание ссылок из typography.css */
	}

	.header-button:focus-visible {
		outline: 2px solid var(--color-text); /* DESIGN.md §7: видимый фокус, значение то же, что и раньше на этих кнопках — план Т4 просит согласовать своё, но не даёт числа */
		outline-offset: 2px;
	}

	.header-button--solid:focus-visible {
		outline-offset: 3px; /* обводка не должна сливаться с красной заливкой */
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
