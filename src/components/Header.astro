---
/*
 * Шапка — ветка hero-ref-2026-08-09, по референсу
 * ../references/04_screens/Реф новый 09.08.png.
 *
 * Отличия от main: вместо одной капсулы, которая при прокрутке сворачивалась
 * в кнопку «Контакты» и раскрывалась столбиком, здесь ДВЕ простые кнопки
 * без значков — «Контакты» и «Резюме». Решение заказчика: «Контакты
 * и Резюме, 2 кнопки без значков, пусть также будут липучкой».
 *
 * Стиль кнопок не менялся: то же матовое стекло на токенах --glass-*.
 * Заказчик отдельно оговорил, что кнопки нравятся именно наши, из референса
 * взят только состав. Тёмная заливка «Резюме» из референса НЕ переносится:
 * сплошная плашка рядом со стеклянной — два разных материала в одной строке,
 * плюс шапка плавает над тёмными обложками кейсов, где чёрная кнопка
 * пропадёт. Это вопрос к заказчику, а не решение исполнителя.
 *
 * Раскрывающийся список Телеграм/Email убран: «Контакты» ведут на
 * страницу /contacts, где те же ссылки лежат крупными строками. Механика
 * раскрытия вместе с ней ушла, а с ней и весь класс проблем — наложение
 * на аватар, прокрутка при наведении, вспышка списка при появлении.
 *
 * Аватар-кружок ЦВЕТНОЙ: фильтр grayscale снят по решению заказчика,
 * DESIGN.md §2 «Прочее» поправлен под это в той же ветке.
 */
import { contacts } from '../data/contacts.ts';
import { withBase } from '../lib/url';

const resume = contacts.find((contact) => contact.icon === 'resume');
---

<header class="site-header" data-header>
	<div class="site-header__inner container">
		<div class="avatar-glass">
			<img class="avatar" src={withBase('media/avatar/head-thumb.webp')} alt="" aria-hidden="true" width="256" height="256" />
		</div>

		<nav class="site-header__actions" aria-label="Связаться">
			<a class="header-button" href={withBase('contacts/')}>Контакты</a>
			{resume && (
				<a
					class="header-button"
					href={resume.href}
					target={resume.external ? '_blank' : undefined}
					rel={resume.external ? 'noopener noreferrer' : undefined}
				>
					Резюме
					{resume.external && <span class="visually-hidden">(откроется в новом окне)</span>}
				</a>
			)}
		</nav>
	</div>
</header>

<style>
	/*
	 * Фон самой шапки прозрачный, стекло — на капсулах: аватар слева
	 * и кнопки справа.
	 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: transparent;
		padding-block: calc(var(--space-header-to-hero) / 2);
	}

	.site-header__inner {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
	}

	.site-header__actions {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: calc(var(--space-unit) * 2);
	}

	/*
	 * Матовое стекло — общий вид капсул (токены в tokens.css).
	 *
	 * Без -webkit-префикса намеренно: минификатор считает пару объявлений
	 * дублем и оставляет префиксную строку, которую Chrome уже не понимает.
	 * История в main, коммит 1778c4d.
	 */
	.avatar-glass,
	.header-button {
		background-color: var(--glass-bg);
		border: 1px solid var(--glass-border);
		box-shadow: var(--glass-shadow);
		backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
	}

	/* Окантовка аватара: тонкое кольцо вокруг круга. */
	.avatar-glass {
		justify-self: start;
		padding: 6px;
		border-radius: 50%;
		line-height: 0;
	}

	/* Фото заказчика, обрезанное по голове (head-thumb.webp, 256px — запас
	   почти впятеро от показываемых 52).
	   Цветное: фильтр grayscale снят в этой ветке по решению заказчика,
	   DESIGN.md §2 «Прочее» обновлён.
	   Круглая маска остаётся: §2 сняла её только с героя. */
	.avatar {
		display: block;
		width: 52px;
		height: 52px;
		border-radius: 50%; /* DESIGN.md §2 «Скругления»: аватар-миниатюра — круг */
		object-fit: cover;
		background-color: var(--color-surface); /* фон под загрузку файла */
	}

	.header-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 52px; /* та же высота, что у капсулы аватара */
		padding-inline: calc(var(--space-unit) * 5);
		border-radius: var(--radius-pill-group); /* DESIGN.md §2: 24px */
		font-family: var(--font-body);
		font-size: var(--text-pill-compact-size);
		font-weight: var(--text-pill-compact-weight);
		color: var(--color-text);
		white-space: nowrap;
	}

	.header-button:hover,
	.header-button:focus-visible {
		text-decoration: none; /* отменяет глобальное подчёркивание ссылок из typography.css */
	}

	.header-button:focus-visible {
		outline: 2px solid var(--color-text); /* DESIGN.md §7: видимый фокус */
		outline-offset: 2px;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
