---
/*
 * Шапка — DESIGN.md §3, блок 1: круглый аватар-миниатюра 61×61 слева,
 * по центру группа пилюль на подложке.
 *
 * Центрирование группы пилюль: сетка 1fr auto 1fr — аватар в первой колонке,
 * пилюли во второй; колонки 1 и 3 равны, поэтому средняя колонка оказывается
 * по центру без привязки к ширине аватара. Инженерное решение, не значение
 * из спецификации.
 *
 * Правка 05.08.2026: на мобильном (<600px) сетка меняется на
 * `auto minmax(0, 1fr)` — колонка «auto» без явного ограничения растёт
 * под содержимое и не даёт ему сжаться (та же ловушка, что раньше толкала
 * страницу в горизонтальную прокрутку). Центрирование на мобильном
 * приносится в жертву: пилюли прижаты к аватару и прокручиваются внутри
 * своей колонки (ContactPills.astro), а не растягивают шапку.
 *
 * Блюр подложки и переключение цвета над тёмным блоком кейса — отдельная
 * анимация из DESIGN.md §4 (переключение цвета над тёмным блоком кейса не
 * входит в карточки Ф11, остаётся отложенной). Числового радиуса блюра
 * в токенах нет — без него подложка сейчас непрозрачная, цветом
 * --color-surface («подложка группы пилюль» в DESIGN.md §2).
 *
 * P11-T2 (05.08.2026) — DESIGN.md §3 «Поведение шапки и подвала», §4:
 * два независимых состояния через классы is-compact/is-hidden, оба
 * переключаются IntersectionObserver'ом, не обработчиком scroll (DESIGN.md
 * §3: «через IntersectionObserver, не по обработчику scroll — обработчик
 * на каждый пиксель прокрутки бьёт по производительности»).
 *
 * — is-compact включается, когда [data-viewport-sentinel] (Base.astro,
 *   высота 100vh) уходит из вида — то есть прокрутили дальше первого экрана.
 * — is-hidden включается, когда [data-footer] (Footer.astro) появляется
 *   в поле зрения, и снимается, как только подвал снова не виден —
 *   при прокрутке вверх шапка возвращается автоматически, отдельного кода
 *   для «обратно» не нужно, это то же состояние at rest.
 *
 * Конкретные размеры сжатого состояния не заданы в DESIGN.md — там только
 * качественное «уменьшаются» — инженерный дефолт по образцу решений
 * P4-T2/P5-T1 для незафиксированных чисел: сжатое состояние держит
 * примерно те же ~72% от обычного, что и до правки ниже.
 *
 * Правка 05.08.2026 по прямому запросу пользователя («слишком маленькие
 * кнопки и шрифт, полупрозрачная рамка липучки»):
 *   — аватар и подложка группы пилюль увеличены с 61px до 72px (обычное
 *     состояние), сжатое — с 44px до 52px, те же ~72%;
 *   — сама пилюля (ContactPills.astro) — с 37px до 44px, иконка — с 16 до 18px;
 *   — текст пилюли — токен --text-pill-size в tokens.css, отдельный комментарий там;
 *   — добавлена полупрозрачная подложка с блюром в сжатом состоянии —
 *     DESIGN.md §4, строка «Шапка / скролл > высоты героя»: значения
 *     backdrop-filter: blur(12px) и --color-surface-translucent (0.72)
 *     были в спецификации с самого начала, но не подключены в коде —
 *     теперь подключены на том же триггере, что и сжатие (is-compact),
 *     это буквально одна строка в таблице DESIGN.md §4, а не новая анимация.
 */
import ContactPills from './ContactPills.astro';
import { withBase } from '../lib/url';
---

<header class="site-header" data-header>
	<div class="site-header__inner container">
		<div class="avatar-glass">
			<img class="avatar" src={withBase('media/avatar/head-poster.webp')} alt="" aria-hidden="true" width="1240" height="1240" />
		</div>
		<div class="pill-group">
			<ContactPills />
		</div>
		<a class="contacts-link" href={withBase('contacts/')}>
			<span>Контакты</span>
			<svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
				<path
					d="M4 12L12 4M8 4H12V8"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const sentinel = document.querySelector<HTMLElement>('[data-viewport-sentinel]');
	const footer = document.querySelector<HTMLElement>('[data-footer]');

	if (header && sentinel) {
		// компактность: сентинел высотой в экран ушёл из вида — пролистали дальше первого экрана
		const compactObserver = new IntersectionObserver(([entry]) => {
			header.classList.toggle('is-compact', !entry.isIntersecting);
		});
		compactObserver.observe(sentinel);
	}

	if (header && footer) {
		// исчезновение у подвала: показался подвал — прячем шапку, ушёл из вида — возвращаем
		const footerObserver = new IntersectionObserver(([entry]) => {
			header.classList.toggle('is-hidden', entry.isIntersecting);
		});
		footerObserver.observe(footer);
	}
</script>

<style>
	/*
	 * Правка 05.08.2026 по прямому запросу пользователя: шапка перестала быть
	 * сплошной полосой. Фон самой шапки прозрачный, стекло — на двух отдельных
	 * капсулах: аватар слева и группа контактов по центру.
	 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: transparent;
		/* Переиспользован токен «шапка → фото героя» (20px) и сверху, и снизу:
		   он же задаёт отступ от шапки до героя, только теперь это внутренний
		   отступ самой шапки, а не внешний margin следующего блока. */
		padding-block: var(--space-header-to-hero);
		transform: translateY(0);
		transition:
			padding-block 300ms ease-out,
			transform 300ms ease-out,
			background-color 300ms ease-out,
			backdrop-filter 300ms ease-out; /* DESIGN.md §4: 300 мс ease-out на все состояния */
	}

	/* P11-T2 + правка 05.08: сжатие после первого экрана — вертикальные
	   отступы вполовину, плюс полупрозрачная подложка с блюром из DESIGN.md
	   §4 (значения архитектора, не замер — см. tokens.css). */
	.site-header.is-compact {
		padding-block: calc(var(--space-header-to-hero) / 2);
	}

	/* P11-T2: исчезновение у подвала — уезжает вверх за пределы экрана. */
	.site-header.is-hidden {
		transform: translateY(-100%);
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			transition: none; /* DESIGN.md §4: состояния переключаются мгновенно */
		}
	}

	.site-header__inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}

	@media (max-width: 599px) {
		.site-header__inner {
			/* Две колонки: аватар слева, кнопка «Контакты» справа. Прокрутка
			   группы пилюль больше не нужна — группа на мобильном скрыта. */
			grid-template-columns: auto 1fr;
		}
	}

	/* Матовое стекло — общий вид обеих капсул (токены в tokens.css).
	 *
	 * Правка 08.08.2026. Здесь стояла пара объявлений: стандартное
	 * backdrop-filter и следом -webkit-backdrop-filter «для Safari».
	 * Минификатор счёл их дублем одного свойства и оставил в собранном CSS
	 * только вторую, префиксную строку. Chrome алиас -webkit-backdrop-filter
	 * больше не поддерживает (CSS.supports вернул false на живом сайте),
	 * поэтому стекло не отрисовывалось нигде: getComputedStyle отдавал
	 * backdrop-filter: none при корректном коде компонента.
	 * Префиксную строку убрали: Safari работает без префикса с 18-й версии,
	 * префикс был нужен для 15.4. Одно объявление минификатору не с чем
	 * склеивать. Проверка после сборки — grep по dist/_astro/*.css: должно
	 * найтись backdrop-filter без префикса. */
	.avatar-glass,
	.pill-group {
		background-color: var(--glass-bg);
		border: 1px solid var(--glass-border);
		box-shadow: var(--glass-shadow);
		backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
	}

	/* Окантовка аватара: тонкое кольцо вокруг круга, размер не меняется
	   при скролле — «статичная» по запросу пользователя. */
	.avatar-glass {
		justify-self: start;
		padding: 6px;
		border-radius: 50%;
		line-height: 0;
	}

	/* Правка 09.08.2026: здесь стояла пустая заглушка --color-surface (серый
	   круг на скриншотах заказчика). Подставлен постер аватара — тот же файл,
	   что и в герое. Чёрно-белый фильтр — DESIGN.md §2 «Прочее»: «фото аватара
	   в шапке чёрно-белое, фото в герое цветное». Круглая маска здесь
	   остаётся: DESIGN.md §2 снял её только с героя. */
	.avatar {
		display: block;
		width: 72px; /* DESIGN.md §3 давал 61×61 — увеличено 05.08 по запросу пользователя */
		height: 72px;
		border-radius: 50%; /* DESIGN.md §2 «Скругления»: аватар-миниатюра — круг */
		object-fit: cover;
		filter: grayscale(1); /* DESIGN.md §2 «Прочее» */
		background-color: var(--color-surface); /* фон под загрузку файла */
	}

	.pill-group {
		grid-column: 2;
		min-width: 0; /* грид-элемент по умолчанию не сжимается меньше содержимого — блокирует overflow-x внутри ContactPills на мобильном без этой строки */
		height: 72px; /* DESIGN.md §2 давал 61px — увеличено 05.08 по запросу пользователя, вместе с аватаром */
		/* 12px — внутренний боковой отступ подложки не задан в DESIGN.md, инженерный дефолт */
		padding-inline: calc(var(--space-unit) * 3);
		display: flex;
		align-items: center;
		/* Правка 08.08.2026 по решению заказчика («стеклянным должен быть
		   ободок группы, не сами пилюли»): здесь стояло
		   background-color: var(--color-surface) — непрозрачный #F3F3F3.
		   Правило .pill-group объявлено в этом файле дважды, и это, второе,
		   перекрывало --glass-bg из общего правила капсул выше по порядку
		   в источнике. Заливку задаёт только общее правило, здесь её нет. */
		border-radius: var(--radius-pill-group); /* DESIGN.md §2: 24px */
		transition: height 300ms ease-out;
	}

	/* P11-T2: сжатое состояние аватара и группы пилюль — DESIGN.md §4 «аватар
	   и пилюли уменьшаются», числа не заданы в спецификации, инженерный
	   дефолт ~72% от обычного размера (72 → 52, та же пропорция, что была
	   у прежних 61 → 44 до правки размеров 05.08). */
	/* Аватар при сжатии не меняется — по запросу пользователя окантовка слева
	   статична; сжимается только группа контактов и отступы шапки. */
	.site-header.is-compact .pill-group {
		height: 52px;
	}

	/* Мобильная замена группы: одна кнопка, ведущая на страницу контактов.
	   Причина — на 375px три пилюли не помещаются даже с прокруткой группы
	   (правка 05.08.2026, DESIGN.md §3). */
	.contacts-link {
		display: none;
		align-items: center;
		gap: 4px;
		height: 52px;
		padding-inline: calc(var(--space-unit) * 5);
		border-radius: var(--radius-pill-group);
		font-family: var(--font-body);
		font-size: var(--text-pill-size);
		font-weight: var(--text-pill-weight);
		color: var(--color-text);
		text-decoration: none;
		background-color: var(--glass-bg);
		border: 1px solid var(--glass-border);
		box-shadow: var(--glass-shadow);
		backdrop-filter: blur(var(--glass-blur)) saturate(1.4); /* без -webkit-префикса, причина — в комментарии у правила капсул выше */
	}

	.contacts-link:hover,
	.contacts-link:focus-visible {
		text-decoration: none;
	}

	.contacts-link:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 2px;
	}

	@media (max-width: 599px) {
		.pill-group {
			display: none;
		}

		.contacts-link {
			display: inline-flex;
			justify-self: end;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.avatar,
		.pill-group {
			transition: none;
		}
	}
</style>
