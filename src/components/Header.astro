---
/*
 * Шапка — по коду макета из Figma, references/02_sites/Код из фигмы.md
 * (правка 09.08.2026, вечер). Референс-снимок: references/04_screens/
 * Реф новый 09.08.png.
 *
 * Геометрия взята из макета дословно: аватар 44×44 на отметке 60px
 * от верха, поле по бокам 80px, две кнопки высотой 44 с полем 20,
 * радиусом 100 и зазором 16, текст 20/500, тень 0 1px 2px rgba(0,0,0,.16).
 *
 * ── Что из референса НЕ взято, и почему ──────────────────────────────────
 * Заливка кнопок. В макете чёрная кнопка — «Резюме», обведённая —
 * «Контакты». Заказчик 09.08 оставил распределение прежним: «цвета оставь
 * как были, белое резюме чёрные контакты». Черной остаётся «Контакты»
 * (основное действие, ведёт в телеграм), «Резюме» — белая с обводкой.
 * Форма, размер, радиус, тень и толщина обводки при этом ровно макетные:
 * поменялось только то, какая из двух кнопок какую роль носит.
 *
 * ── Стекло убрано ────────────────────────────────────────────────────────
 * Матового стекла (--glass-*) в шапке больше нет: в референсе плоские
 * кнопки на белом с волосяной тенью, а у аватара нет кольца. Токены
 * --glass-* остаются в проекте — на них стоит волосяная граница медиа
 * кейса (layout.css).
 *
 * ── Обводка через inset box-shadow, не border ────────────────────────────
 * В макете это outline с offset -2, то есть линия внутри и без влияния
 * на размер. border: 2px при box-sizing: border-box съел бы 4px высоты
 * и 4px полей, кнопка перестала бы совпадать с чёрной. inset-тень даёт
 * ту же линию и не трогает раскладку, а свойство outline остаётся
 * свободным для видимого фокуса.
 *
 * Аватар-кружок цветной (grayscale снят 09.08 решением заказчика).
 */
import { contacts } from '../data/contacts.ts';
import { withBase } from '../lib/url';

const telegram = contacts.find((contact) => contact.icon === 'telegram');
const resume = contacts.find((contact) => contact.icon === 'resume');
---

<header class="site-header" data-header>
	<div class="site-header__inner">
		<img
			class="avatar"
			src={withBase('media/avatar/head-thumb.webp')}
			alt=""
			aria-hidden="true"
			width="256"
			height="256"
		/>

		<nav class="site-header__actions" aria-label="Связаться">
			{telegram && (
				<a class="header-button header-button--solid" href={telegram.href} target="_blank" rel="noopener noreferrer">
					Контакты
					<span class="visually-hidden">, Телеграм (откроется в новом окне)</span>
				</a>
			)}
			{resume && (
				<a class="header-button header-button--outline" href={resume.href} target="_blank" rel="noopener noreferrer">
					Резюме
					<span class="visually-hidden">(откроется в новом окне)</span>
				</a>
			)}
		</nav>
	</div>
</header>

<style>
	/*
	 * Фон шапки прозрачный: она плавает над первым экраном, где по макету
	 * верх аватара героя (40px) выше верха кнопок (60px).
	 *
	 * Поля снизу нет намеренно — нижняя граница шапки совпадает с нижним
	 * краем кнопок, и на этом стоит --space-sticky-header, от которого
	 * считаются отступы блоков кейсов.
	 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: transparent;
		padding-top: var(--space-header-top);
	}

	/*
	 * Свой контейнер вместо .container: в макете поле шапки 80px против
	 * 50px у остальной страницы. Мобильная и планшетная ступени те же,
	 * что в layout.css (20 и 32) — про них референс ничего не говорит.
	 */
	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-header-gap);
		width: 100%;
		margin-inline: auto;
		padding-inline: 20px;
	}

	@media (min-width: 600px) {
		.site-header__inner {
			padding-inline: 32px;
		}
	}

	@media (min-width: 1024px) {
		.site-header__inner {
			max-width: 1440px; /* макет 1440: 1440 - 2×80 даёт контент 1280 */
			padding-inline: var(--space-header-side);
		}
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: var(--space-header-gap);
	}

	/* Фото заказчика, обрезанное по голове (head-thumb.webp, 256px — запас
	   почти шестикратный к показываемым 44). Круглая маска остаётся:
	   DESIGN.md §2 сняла её только с героя. */
	.avatar {
		display: block;
		width: var(--size-header-control);
		height: var(--size-header-control);
		border-radius: 50%;
		object-fit: cover;
		background-color: var(--color-surface); /* фон под загрузку файла */
	}

	.header-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: var(--size-header-control);
		padding-inline: var(--space-header-button-padding);
		border-radius: var(--radius-pill-full);
		font-family: var(--font-body);
		font-size: var(--text-header-button-size);
		font-weight: var(--text-pill-weight); /* 500 «среднее», как в макете */
		line-height: 1;
		white-space: nowrap;
	}

	/* «Контакты» — основное действие, ведёт в телеграм. Цвета существующие:
	   текст страницы становится фоном кнопки, фон страницы — её текстом. */
	.header-button--solid {
		background-color: var(--color-text);
		color: var(--color-bg);
		box-shadow: var(--shadow-control);
	}

	/* «Резюме» — белая с обводкой 2px, толщина из макета. */
	.header-button--outline {
		background-color: var(--color-bg);
		color: var(--color-text);
		box-shadow:
			inset 0 0 0 2px var(--color-text),
			var(--shadow-control);
	}

	.header-button:hover,
	.header-button:focus-visible {
		text-decoration: none; /* отменяет глобальное подчёркивание ссылок из typography.css */
	}

	.header-button:focus-visible {
		outline: 2px solid var(--color-text); /* DESIGN.md §7: видимый фокус */
		outline-offset: 2px;
	}

	.header-button--solid:focus-visible {
		outline-offset: 3px; /* обводка не должна сливаться с чёрной заливкой */
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
