---
/*
 * Шапка — DESIGN.md §3, блок 1: круглый аватар-миниатюра 61×61 слева,
 * по центру группа пилюль на подложке.
 *
 * Центрирование группы пилюль: сетка 1fr auto 1fr — аватар в первой колонке,
 * пилюли во второй; колонки 1 и 3 равны, поэтому средняя колонка оказывается
 * по центру без привязки к ширине аватара. Инженерное решение, не значение
 * из спецификации.
 *
 * Правка 05.08.2026: на мобильном (<600px) сетка меняется на
 * `auto minmax(0, 1fr)` — колонка «auto» без явного ограничения растёт
 * под содержимое и не даёт ему сжаться (та же ловушка, что раньше толкала
 * страницу в горизонтальную прокрутку). Центрирование на мобильном
 * приносится в жертву: пилюли прижаты к аватару и прокручиваются внутри
 * своей колонки (ContactPills.astro), а не растягивают шапку.
 *
 * Блюр подложки и переключение цвета над тёмным блоком кейса — отдельная
 * анимация из DESIGN.md §4 (переключение цвета над тёмным блоком кейса не
 * входит в карточки Ф11, остаётся отложенной). Числового радиуса блюра
 * в токенах нет — без него подложка сейчас непрозрачная, цветом
 * --color-surface («подложка группы пилюль» в DESIGN.md §2).
 *
 * ── История сжатия шапки, отменена 09.08.2026 ────────────────────────────
 * P11-T2 (05.08.2026) вводил два независимых состояния через классы
 * is-compact/is-hidden: шапка стартовала крупной (72px аватар и пилюли) и
 * сжималась после прокрутки дальше первого экрана. По прямому замечанию
 * заказчика («непонятно зачем липучка сначала такая жирная и белая, а ниже
 * уменьшается — пусть всегда будет аккуратная и поменьше») is-compact и его
 * IntersectionObserver убраны целиком. Шапка теперь всегда в одном размере —
 * прежнем «сжатом» состоянии, ставшем единственным.
 *
 * is-hidden (исчезновение у подвала) не тронут — на него замечаний не было,
 * и он отдельная задача: при показе подвала шапка уезжает вверх, чтобы не
 * дублировать контакты на экране дважды.
 */
import ContactPills from './ContactPills.astro';
import { withBase } from '../lib/url';
---

<header class="site-header" data-header>
	<div class="site-header__inner container">
		<div class="avatar-glass">
			<img class="avatar" src={withBase('media/avatar/head-poster.webp')} alt="" aria-hidden="true" width="1240" height="1240" />
		</div>
		<div class="pill-group">
			<ContactPills />
		</div>
		<a class="contacts-link" href={withBase('contacts/')}>
			<span>Контакты</span>
			<svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
				<path
					d="M4 12L12 4M8 4H12V8"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const footer = document.querySelector<HTMLElement>('[data-footer]');

	if (header && footer) {
		// исчезновение у подвала: показался подвал — прячем шапку, ушёл из вида — возвращаем
		const footerObserver = new IntersectionObserver(([entry]) => {
			header.classList.toggle('is-hidden', entry.isIntersecting);
		});
		footerObserver.observe(footer);
	}
</script>

<style>
	/*
	 * Правка 05.08.2026 по прямому запросу пользователя: шапка перестала быть
	 * сплошной полосой. Фон самой шапки прозрачный, стекло — на двух отдельных
	 * капсулах: аватар слева и группа контактов по центру.
	 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: transparent;
		/* Правка 09.08.2026: было var(--space-header-to-hero) (20px, полный
		   размер) со сжатием вполовину после скролла. Сжатое состояние стало
		   единственным — здесь сразу половина, токен ужимать вдвое больше
		   негде переключением класса. */
		padding-block: calc(var(--space-header-to-hero) / 2);
		transform: translateY(0);
		transition:
			transform 300ms ease-out; /* DESIGN.md §4: 300 мс ease-out — теперь только на is-hidden */
	}

	/* Исчезновение у подвала — уезжает вверх за пределы экрана. */
	.site-header.is-hidden {
		transform: translateY(-100%);
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			transition: none; /* DESIGN.md §4: состояния переключаются мгновенно */
		}
	}

	.site-header__inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}

	@media (max-width: 599px) {
		.site-header__inner {
			/* Две колонки: аватар слева, кнопка «Контакты» справа. Прокрутка
			   группы пилюль больше не нужна — группа на мобильном скрыта. */
			grid-template-columns: auto 1fr;
		}
	}

	/* Матовое стекло — общий вид обеих капсул (токены в tokens.css).
	 *
	 * Правка 08.08.2026. Здесь стояла пара объявлений: стандартное
	 * backdrop-filter и следом -webkit-backdrop-filter «для Safari».
	 * Минификатор счёл их дублем одного свойства и оставил в собранном CSS
	 * только вторую, префиксную строку. Chrome алиас -webkit-backdrop-filter
	 * больше не поддерживает (CSS.supports вернул false на живом сайте),
	 * поэтому стекло не отрисовывалось нигде: getComputedStyle отдавал
	 * backdrop-filter: none при корректном коде компонента.
	 * Префиксную строку убрали: Safari работает без префикса с 18-й версии,
	 * префикс был нужен для 15.4. Одно объявление минификатору не с чем
	 * склеивать. Проверка после сборки — grep по dist/_astro/*.css: должно
	 * найтись backdrop-filter без префикса. */
	.avatar-glass,
	.pill-group {
		background-color: var(--glass-bg);
		border: 1px solid var(--glass-border);
		box-shadow: var(--glass-shadow);
		backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
	}

	/* Окантовка аватара: тонкое кольцо вокруг круга. */
	.avatar-glass {
		justify-self: start;
		padding: 6px;
		border-radius: 50%;
		line-height: 0;
	}

	/* Правка 09.08.2026: здесь стояла пустая заглушка --color-surface (серый
	   круг на скриншотах заказчика). Подставлен постер аватара — тот же файл,
	   что и в герое. Чёрно-белый фильтр — DESIGN.md §2 «Прочее»: «фото аватара
	   в шапке чёрно-белое, фото в герое цветное». Круглая маска здесь
	   остаётся: DESIGN.md §2 снял её только с героя.
	   Размер 52px — правка 09.08.2026: раньше аватар держал 72px (крупное
	   состояние) статично, пока пилюли сжимались вокруг него до 52px при
	   скролле — с этой правкой крупного состояния больше нет вовсе, обе
	   капсулы приведены к одной, уже существовавшей «сжатой» высоте. */
	.avatar {
		display: block;
		width: 52px;
		height: 52px;
		border-radius: 50%; /* DESIGN.md §2 «Скругления»: аватар-миниатюра — круг */
		object-fit: cover;
		filter: grayscale(1); /* DESIGN.md §2 «Прочее» */
		background-color: var(--color-surface); /* фон под загрузку файла */
	}

	.pill-group {
		grid-column: 2;
		min-width: 0; /* грид-элемент по умолчанию не сжимается меньше содержимого — блокирует overflow-x внутри ContactPills на мобильном без этой строки */
		height: 52px; /* правка 09.08.2026: единственное состояние теперь, было 72 крупное / 52 сжатое */
		/* 12px — внутренний боковой отступ подложки не задан в DESIGN.md, инженерный дефолт */
		padding-inline: calc(var(--space-unit) * 3);
		display: flex;
		align-items: center;
		/* Правка 08.08.2026 по решению заказчика («стеклянным должен быть
		   ободок группы, не сами пилюли»): здесь стояло
		   background-color: var(--color-surface) — непрозрачный #F3F3F3.
		   Правило .pill-group объявлено в этом файле дважды, и это, второе,
		   перекрывало --glass-bg из общего правила капсул выше по порядку
		   в источнике. Заливку задаёт только общее правило, здесь её нет. */
		border-radius: var(--radius-pill-group); /* DESIGN.md §2: 24px */
	}

	/* Мобильная замена группы: одна кнопка, ведущая на страницу контактов.
	   Причина — на 375px три пилюли не помещаются даже с прокруткой группы
	   (правка 05.08.2026, DESIGN.md §3). */
	.contacts-link {
		display: none;
		align-items: center;
		gap: 4px;
		height: 52px;
		padding-inline: calc(var(--space-unit) * 5);
		border-radius: var(--radius-pill-group);
		font-family: var(--font-body);
		font-size: var(--text-pill-size);
		font-weight: var(--text-pill-weight);
		color: var(--color-text);
		text-decoration: none;
		background-color: var(--glass-bg);
		border: 1px solid var(--glass-border);
		box-shadow: var(--glass-shadow);
		backdrop-filter: blur(var(--glass-blur)) saturate(1.4); /* без -webkit-префикса, причина — в комментарии у правила капсул выше */
	}

	.contacts-link:hover,
	.contacts-link:focus-visible {
		text-decoration: none;
	}

	.contacts-link:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 2px;
	}

	@media (max-width: 599px) {
		.pill-group {
			display: none;
		}

		.contacts-link {
			display: inline-flex;
			justify-self: end;
		}
	}
</style>
