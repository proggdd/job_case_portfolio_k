---
/*
 * CaseGallery — DESIGN.md §3 «Компоненты»: состояния «заглушки, реальные
 * изображения». Пропорции галереи в спецификации сознательно не заданы
 * (§6: «галерея — по факту будущих изображений») — решается, когда
 * появятся реальные файлы.
 *
 * Серая плашка-заглушка убрана 11.08.2026 (PLAN-C-HERO-FONTS-2026-08-11.md,
 * C7) по прямому решению заказчика: «уберите серый квадрат со вкладок
 * внизу, добавим блоки позже». При пустом массиве компонент не рендерит
 * ничего — сама галерея вернётся, когда появятся файлы, ветка с реальными
 * изображениями не менялась.
 *
 * `alt` для реальных изображений — по заголовку кейса и порядковому
 * номеру.
 */
import { withBase } from '../lib/url';

interface Props {
	images: string[];
	title: string;
}

const { images, title } = Astro.props;

/* Пути относительные, склейка — через общий withBase (src/lib/url.ts). */
const sources = images.map((path) => withBase(path));
---

{
	sources.length > 0 && (
		<ul class="case-gallery">
			{sources.map((src, index) => (
				<li>
					<img
						class="case-gallery__item"
						src={src}
						alt={`Кадр экрана «${title}», ${index + 1}`}
						loading="lazy"
						decoding="async"
					/>
				</li>
			))}
		</ul>
	)
}

<style>
	.case-gallery {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-case-to-case); /* переиспользован токен «кейс → кейс» — своего для галереи в DESIGN.md нет */
	}

	/* Волосяная граница — то же решение, что у .case-media (layout.css,
	   09.08.2026): светлый кадр не должен растворяться в белой странице. */
	.case-gallery__item {
		width: 100%;
		border-radius: var(--radius-media);
		border: 1px solid var(--glass-border);
	}
</style>
