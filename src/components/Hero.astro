---
/*
 * Hero — герой главной, DESIGN.md §3 блок 2, карточки P5-T7 и P5-T6.
 *
 * Имя — единственный <h1> страницы (DESIGN.md §8: один H1 на страницу).
 * Специализация — <h2>, следующий уровень иерархии без пропусков.
 * Сегменты — не заголовок: DESIGN.md §3 описывает их как метаданные при
 * специализации, поэтому <p> со стилем токена --text-segments-*.
 *
 * ── Видео-аватар: правка от 05.08.2026 (после P11-T4) ────────────────────
 * По прямому указанию пользователя материал и логика заменены во второй
 * раз в тот же день. История P5-T6/P11-T4 (дуга ±45°, две оси, курсор)
 * больше не действует — оставлена ниже только как источник технических
 * приёмов (all-intra, круглая маска), которые применимости не потеряли.
 *
 * Новый исходник — полный оборот на 360° (дизайнер накладывает файл сам,
 * путь `media/avatar/head.mp4` не менялся). Управление — только скроллом,
 * одинаково на десктопе и мобильном: ни курсор, ни вторая (вертикальная)
 * ось больше не используются — прямое решение пользователя, отменяющее
 * прежнее разделение «мышь → курсор, тач → скролл» и наклон ±4° из
 * DESIGN.md §4. Положение головы (currentTime) следует за прогрессом
 * прокрутки первого экрана (0 на верху страницы, 1 на высоте одного
 * экрана) — тот же расчёт, что раньше был только в мобильной ветке,
 * теперь единственный и общий.
 *
 * Технические приёмы, унаследованные без изменений:
 *   — all-intra-перекодирование ролика (если сохранится в новом файле) —
 *     нужно для рваной перемотки покадрово, решение не про этот код;
 *   — круглая маска `.hero__media { border-radius: 50%; overflow: hidden }`
 *     вместо mix-blend-mode — тот же приём, что в P11-T4: фон страницы
 *     и видео совпадают, обрезка физическая, а не цветовым совпадением;
 *   — бюджет: файл грузится по IntersectionObserver только когда герой
 *     попал в поле зрения (DESIGN.md §6), не раньше — правило не менялось;
 *   — prefers-reduced-motion: видео не грузится совсем, виден статичный
 *     постер анфас — без исключений по устройству.
 *
 * DESIGN.md §4 «Аватар, мобильный» формально описывал это поведение только
 * для тач-устройств — теперь оно действует везде по прямому решению
 * пользователя в чате; когда архитектор в следующий раз будет сверять
 * DESIGN.md с кодом (design-spec-keeper), строку стоит обновить, чтобы
 * не читалась как «только мобильный».
 *
 * ── Появление при скролле (P11-T5) ───────────────────────────────────────
 * Четыре data-reveal на медиа/имя/специализацию/сегменты — лесенка внутри
 * блока (DESIGN.md §4: 90 мс на каждый следующий), а не общий data-reveal
 * на всю <section class="hero"> сразу: герой на первом экране виден целиком
 * с самого начала, без лесенки все четыре элемента проявились бы одним
 * кадром. Общий IntersectionObserver — в Base.astro, здесь только разметка
 * и --reveal-delay (0/90/180/270 мс).
 */
import { withBase } from '../lib/url';

const poster = withBase('media/avatar/head-poster.webp');
const video = withBase('media/avatar/head.mp4');
---

<section class="hero">
	<div class="hero__text">
		<h1 class="hero__name" data-reveal style="--reveal-delay: 90ms">Кирилл Колобанов</h1>
		<h2 class="hero__specialization" data-reveal style="--reveal-delay: 180ms">UX/UI дизайнер, 3 года опыта</h2>
		<p class="hero__segments" data-reveal style="--reveal-delay: 270ms">B2B, B2C</p>
		<p class="hero__pitch" data-reveal style="--reveal-delay: 360ms">
			Проектирую мобильные приложения и веб-сервисы: сценарии, прототип, интерфейс, передача макетов
			в разработку. Работаю с продуктовыми командами и студиями.
		</p>
	</div>
	<div class="hero__media" data-hero-media data-reveal style="--reveal-delay: 0ms">
		<img class="hero__poster" src={poster} alt="Кирилл Колобанов" width="1240" height="1240" />
		<video
			class="hero__video"
			data-hero-video
			src={video}
			muted
			playsinline
			preload="none"
			aria-hidden="true"
			tabindex="-1"></video>
	</div>
</section>

<style>
	/*
	 * Правка 09.08.2026, DESIGN.md §3 блок 2 в новой редакции.
	 * Было: вертикальный центрированный стек (фото, имя, специализация,
	 * сегменты — все центры на 720 по замерам макета). Отменено решением
	 * заказчика: «это должен быть единый блок, аватар и информация, кто это»,
	 * плюс стек высотой 837px не помещался в экран (замер 09.08: 1.16 экрана
	 * на 1280×720). Две колонки дают высоту блока по аватару, и герой
	 * умещается целиком.
	 *
	 * Порядок в разметке — текст, затем медиа: так на мобильном при схлопывании
	 * в одну колонку порядок задаётся `order`, а в DOM остаётся логичный
	 * для скринридера (сначала кто это, потом его портрет).
	 */
	/* Mobile-first: одна колонка по умолчанию, две — с десктопного брейкпоинта
	   1024px (DESIGN.md §5). На планшете 768 две колонки не работают: аватар
	   съедал 620 из 704px контейнера, текстовой колонке оставалось 52px и имя
	   ломалось на двенадцать строк (замер 09.08). */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
		text-align: center;
		gap: var(--space-name-to-specialization);
	}

	.hero__text {
		min-width: 0; /* грид-элемент по умолчанию не сжимается ниже содержимого */
	}

	.hero__media {
		order: -1; /* аватар наверх; в DOM он после текста, чтобы скринридер читал сначала имя */
	}

	@media (min-width: 1024px) {
		.hero {
			/* Место справа под плавающую капсулу контактов — правка 09.08.2026.
			   Замер до неё: свободного места справа от аватара 77px, капсуле
			   нужно 196, отсюда наложение, на которое указал заказчик.
			   Зазор между ними — тот же токен вертикального дыхания шапки,
			   новых значений не заводилось. */
			padding-right: calc(var(--size-contact-panel) + var(--space-header-to-hero));
			/* Ширину колонки аватара задаёт сетка, а не сам элемент: в колонке
			   `auto` процент считать не от чего, и она разворачивалась до
			   внутреннего размера постера (1240px, замер 09.08).
			   46.3% — доля аватара в контейнере по макету: 620 / 1340.
			   Она держит текстовой колонке больше половины ширины на любом
			   десктопе, а minmax(0, …) позволяет колонке сжаться. */
			grid-template-columns: minmax(0, 1fr) minmax(0, min(var(--size-hero-avatar), 46.3%));
			justify-items: stretch;
			text-align: left;
			align-items: center;
		}

		.hero__media {
			order: 0; /* в две колонки порядок задаёт сетка: текст слева, аватар справа */
		}
	}

	/*
	 * Круглая маска и `transform: scale(1.06)` сняты 09.08.2026 (DESIGN.md §2,
	 * строка «Видео-аватар в герое»). Обрезка кругом срезала подбородок на
	 * профиле при повороте головы; масштаб 1.06 вводился 05.08 под тёмные
	 * полосы прежнего исходника, у нового их нет. Фон нового файла после
	 * декодирования — ровно #FFFFFF (замер ffprobe: color_range=tv, Y=235,
	 * растяжение tv→pc даёт 255/255/255), то есть совпадает с --color-bg,
	 * и квадратный кадр на белой странице границ не имеет.
	 */
	.hero__media {
		position: relative;
		width: 100%; /* 100% своей колонки, ширину которой задаёт сетка выше */
		aspect-ratio: 1 / 1;
		/* Фон под видео — цвет страницы. Пока кадр не декодирован, <video>
		   красится браузером в чёрный: отсюда была тёмная полоса по краю
		   при перемотке (замечание от 05.08.2026). */
		background-color: var(--color-bg);
	}

	.hero__poster,
	.hero__video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero__video {
		position: absolute;
		inset: 0;
		visibility: hidden; /* показывается скриптом, только если видео действительно загрузилось */
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__video {
			display: none; /* скрипт и так не грузит видео при reduced motion — на всякий случай и в разметке */
		}
	}

	.hero__media[data-active='true'] .hero__video {
		visibility: visible;
	}

	.hero__media[data-active='true'] .hero__poster {
		visibility: hidden;
	}

	/* Дисплейная гарнитура — только здесь и на заголовке страницы кейса
	   (tokens.css, --font-accent). В ленте заголовки остаются на Inter:
	   они стоят вплотную к постеру со своей крупной надписью. */
	.hero__name {
		margin-top: var(--space-photo-to-name); /* 0px, DESIGN.md §2: фото и имя примыкают */
		font-family: var(--font-accent);
	}

	.hero__specialization {
		margin-top: var(--space-name-to-specialization);
	}

	.hero__segments {
		margin-top: var(--space-specialization-to-segments);
		max-width: none; /* переопределение 66ch из typography.css: короткая строка метаданных */
		font-family: var(--font-body);
		font-size: var(--text-segments-size);
		line-height: var(--text-segments-line-height);
		font-weight: var(--text-segments-weight);
		color: var(--color-text-muted); /* DESIGN.md §2: строка сегментов «B2B, B2C» */
	}

	/*
	 * ⚠️ ЧЕРНОВИК ТЕКСТА, ждёт утверждения Кирилла (карточка K-7).
	 *
	 * Добавлен 09.08.2026 по замечанию заказчика, что справа и слева аватара
	 * пустота. Написан намеренно про автора, а не про конкретные работы:
	 * работы будут меняться, а рамка должна оставаться универсальной — это
	 * его же требование. Текст про кейсы устарел бы с первой заменой
	 * портфолио, текст про то, чем человек занимается, — нет.
	 *
	 * Размер — токен «подзаголовок кейса» (24px), самая мелкая из уже
	 * измеренных текстовых ролей: абзац в герое не должен спорить с именем.
	 * Своей роли «абзац героя» в DESIGN.md §2 нет, новое значение не заведено.
	 */
	.hero__pitch {
		margin-top: var(--space-name-to-specialization);
		max-width: 34ch; /* короткая мера: абзац стоит в колонке рядом с аватаром, а не во всю страницу */
		font-family: var(--font-body);
		font-size: var(--text-case-subtitle-size);
		line-height: var(--text-case-subtitle-line-height);
		font-weight: var(--text-case-subtitle-weight);
		color: var(--color-text-muted);
	}

	@media (max-width: 1023px) {
		.hero__pitch {
			margin-inline: auto; /* в одну колонку блок центрирован — абзац тоже */
		}
	}

	/* До 1024px колонка одна и определённая, поэтому процент считается
	   корректно и аватар ограничивается шириной контейнера. */
	@media (max-width: 1023px) {
		.hero__media {
			width: min(var(--size-hero-avatar), 100%);
		}
	}
</style>

<script>
	/*
	 * Только скролл, одинаково на всех устройствах (правка 05.08.2026 —
	 * см. комментарий в начале файла). Ни курсора, ни второй оси нет.
	 *
	 * Направление: DIRECTION = 1 — скролл вниз поворачивает голову к концу
	 * клипа. Если на живом сайте голова смотрит в противоположную сторону,
	 * поменяйте на -1: единственная строка, которую нужно трогать.
	 */
	const DIRECTION = -1;
	const SMOOTHING = 0.12; // доля пути к цели за кадр: меньше — плавнее и «ленивее»

	const media = document.querySelector<HTMLElement>('[data-hero-media]');
	const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (media && video && !reducedMotion) {
		let targetPosition = 0.5; // currentTime: 0 — начало клипа, 1 — конец
		let currentPosition = 0.5;
		let raf = 0;

		const onScroll = () => {
			const progress = Math.min(Math.max(window.scrollY / window.innerHeight, 0), 1);
			targetPosition = DIRECTION === 1 ? progress : 1 - progress;
		};
		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();

		/*
		 * Перемотка троттлится по двум условиям: пока предыдущий seek не
		 * завершён и пока смещение меньше половины кадра. Без этого код
		 * дёргал currentTime 60 раз в секунду — декодер не успевал, кадр
		 * рисовался частично, по краю круга шла тёмная полоса.
		 */
		const tick = () => {
			currentPosition += (targetPosition - currentPosition) * SMOOTHING;
			if (video.duration && !video.seeking) {
				const next = Math.min(Math.max(currentPosition, 0.001), 0.999) * video.duration;
				const frame = 1 / 15; // частота исходника
				if (Math.abs(next - video.currentTime) > frame / 2) {
					video.currentTime = next;
				}
			}
			raf = requestAnimationFrame(tick);
		};

		video.addEventListener(
			'loadeddata',
			() => {
				media.dataset.active = 'true';
				raf = requestAnimationFrame(tick);
			},
			{ once: true }
		);

		video.addEventListener('error', () => cancelAnimationFrame(raf), { once: true });

		// грузим только когда герой попал в поле зрения — первый экран не ждёт файл целиком.
		const observer = new IntersectionObserver((entries) => {
			if (entries.some((entry) => entry.isIntersecting)) {
				video.preload = 'auto';
				video.load();
				observer.disconnect();
			}
		});
		observer.observe(media);
	}
</script>
