---
/*
 * Герой — ветка hero-ref-2026-08-09, по референсу
 * ../references/04_screens/Реф новый 09.08.png.
 *
 * Отличия от main: аватар по центру, подпись под ним, порядок строк
 * перевёрнут. Было имя → специализация → сегменты двумя строками, стало:
 *
 *     UX/UI дизайнер            роль, серым, размер специализации
 *     Кирилл Колобанов          имя, крупно, полужирным
 *     3 года опыта • B2B, B2C   метаданные одной строкой, серым
 *
 * Роль над именем — редакторский приём «надзаголовок»: сначала ярлык,
 * потом содержание. Опыт и сегменты слиты в одну строку через буллет:
 * в прежней вёрстке это были две отдельные строки, которые конкурировали
 * между собой.
 *
 * <h1> остаётся на имени: это по-прежнему главный заголовок страницы,
 * а роль над ним — не заголовок уровнем выше, а подпись к нему.
 *
 * Абзаца о том, чем занимается автор (.hero__pitch из main), здесь нет:
 * в референсе его нет, а дисциплина первого экрана ограничивает состав
 * четырьмя текстовыми элементами. Решение обратимое, ждёт заказчика.
 *
 * ── Появление при прокрутке отключено 09.08.2026 ──────────────────────────
 * С блока сняты все data-reveal. Причина: наблюдатель появления срабатывает
 * с rootMargin -20% снизу, и нижняя строка «3 года опыта • B2B, B2C»
 * оставалась невидимой, пока страницу не тронешь — заказчик: «строчка не
 * должна выезжать после прокрутки, сразу при заходе должны быть видны
 * 3 строки». Первый экран виден целиком с самого начала, анимировать
 * появление того, что и так перед глазами, смысла нет. В ленте кейсов
 * data-reveal остаётся: там блоки действительно приходят из-за края.
 *
 * Видео-аватар: механика прежняя, поворот головы по прогрессу прокрутки
 * первого экрана, при prefers-reduced-motion остаётся статичный постер.
 */
import { withBase } from '../lib/url';

const poster = withBase('media/avatar/head-poster.webp');
const video = withBase('media/avatar/head.mp4');
---

<section class="hero">
	<div class="hero__media" data-hero-media>
		<img class="hero__poster" src={poster} alt="Кирилл Колобанов" width="1240" height="1240" />
		<video
			class="hero__video"
			data-hero-video
			src={video}
			muted
			playsinline
			preload="none"
			aria-hidden="true"
			tabindex="-1"></video>
	</div>

	<p class="hero__role">UX/UI дизайнер</p>
	<h1 class="hero__name">Кирилл Колобанов</h1>
	<p class="hero__meta">3 года опыта • B2B, B2C</p>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	/*
	 * Круглой маски нет: фон исходника после декодирования — ровно #FFFFFF,
	 * то есть совпадает с --color-bg, и квадратный кадр на белой странице
	 * границ не имеет. Маска вместе с transform: scale(1.06) срезала
	 * подбородок на профиле — решение из main, здесь сохранено.
	 */
	.hero__media {
		position: relative;
		width: var(--size-hero-avatar-centered);
		aspect-ratio: 1 / 1;
		/* Фон под видео — цвет страницы. Пока кадр не декодирован, <video>
		   красится браузером в чёрный, отсюда была тёмная полоса по краю. */
		background-color: var(--color-bg);
	}

	/* Фон на самих кадрах, а не только на обёртке — правка 09.08.2026 по
	   замечанию «чёрные полосы справа и снизу у аватара». В файлах полос нет
	   (замер краёв: 254–255 из 255, видео 1240×1240 при SAR 1:1). Полосы
	   давал сам <video>: сторона блока получается дробной (62.7svh), кадр
	   ложится на неё с округлением, и по правому и нижнему краю проступала
	   подложка элемента, которую браузер красит чёрным. Белый фон под кадром
	   закрывает этот субпиксельный зазор. */
	.hero__poster,
	.hero__video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		background-color: var(--color-bg);
	}

	.hero__video {
		position: absolute;
		inset: 0;
		visibility: hidden; /* показывается скриптом, только если видео действительно загрузилось */
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__video {
			display: none; /* скрипт и так не грузит видео при reduced motion */
		}
	}

	.hero__media[data-active='true'] .hero__video {
		visibility: visible;
	}

	.hero__media[data-active='true'] .hero__poster {
		visibility: hidden;
	}

	/* Роль над именем. Размер — токен специализации, цвет приглушённый:
	   это подпись к имени, а не второй заголовок. */
	.hero__role {
		margin-top: var(--space-name-to-specialization);
		max-width: none; /* переопределяет 66ch из typography.css: строка короткая */
		font-family: var(--font-body);
		font-size: var(--text-specialization-size);
		line-height: var(--text-specialization-line-height);
		font-weight: var(--text-specialization-weight);
		color: var(--color-text-muted);
	}

	.hero__name {
		margin-top: var(--space-photo-to-name); /* 0px, DESIGN.md §2 */
		font-family: var(--font-accent); /* дисплейная гарнитура — только имя и заголовок страницы кейса */
	}

	.hero__meta {
		margin-top: var(--space-name-to-specialization);
		max-width: none;
		font-family: var(--font-body);
		font-size: var(--text-segments-size);
		line-height: var(--text-segments-line-height);
		font-weight: var(--text-segments-weight);
		color: var(--color-text-muted); /* DESIGN.md §2: строка сегментов */
	}
</style>

<script>
	/*
	 * Поворот головы по прогрессу прокрутки первого экрана. Механика
	 * не менялась относительно main.
	 *
	 * Направление: DIRECTION = 1 — прокрутка вниз поворачивает голову
	 * к концу клипа. Если на живом сайте голова смотрит в другую сторону,
	 * поменять на -1: это единственная строка, которую нужно трогать.
	 */
	const DIRECTION = -1;
	const SMOOTHING = 0.12; // доля пути к цели за кадр: меньше — плавнее

	const media = document.querySelector<HTMLElement>('[data-hero-media]');
	const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (media && video && !reducedMotion) {
		let targetPosition = 0.5; // 0 — начало клипа, 1 — конец
		let currentPosition = 0.5;
		let raf = 0;

		const onScroll = () => {
			const progress = Math.min(Math.max(window.scrollY / window.innerHeight, 0), 1);
			targetPosition = DIRECTION === 1 ? progress : 1 - progress;
		};
		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();

		/*
		 * Перемотка троттлится по двум условиям: пока предыдущий seek
		 * не завершён и пока смещение меньше половины кадра. Без этого
		 * декодер не успевал и рисовал кадр частично.
		 */
		const tick = () => {
			currentPosition += (targetPosition - currentPosition) * SMOOTHING;
			if (video.duration && !video.seeking) {
				const next = Math.min(Math.max(currentPosition, 0.001), 0.999) * video.duration;
				const frame = 1 / 15; // частота исходника
				if (Math.abs(next - video.currentTime) > frame / 2) {
					video.currentTime = next;
				}
			}
			raf = requestAnimationFrame(tick);
		};

		video.addEventListener(
			'loadeddata',
			() => {
				media.dataset.active = 'true';
				raf = requestAnimationFrame(tick);
			},
			{ once: true }
		);

		video.addEventListener('error', () => cancelAnimationFrame(raf), { once: true });

		// грузим только когда герой попал в поле зрения — первый экран не ждёт файл
		const observer = new IntersectionObserver((entries) => {
			if (entries.some((entry) => entry.isIntersecting)) {
				video.preload = 'auto';
				video.load();
				observer.disconnect();
			}
		});
		observer.observe(media);
	}
</script>
