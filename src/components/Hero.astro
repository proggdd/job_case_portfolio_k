---
/*
 * Hero — герой главной, DESIGN.md §3 блок 2, карточки P5-T7 и P5-T6.
 *
 * Имя — единственный <h1> страницы (DESIGN.md §8: один H1 на страницу).
 * Специализация — <h2>, следующий уровень иерархии без пропусков.
 * Сегменты — не заголовок: DESIGN.md §3 описывает их как метаданные при
 * специализации, поэтому <p> со стилем токена --text-segments-*.
 *
 * ── Видео-аватар (P5-T6) ──────────────────────────────────────────────
 * Исходник от дизайнера — полный оборот головы на 360° за 15 секунд, а не
 * сектор ±45°, как в инструкции. На краях экрана курсор показывал бы
 * затылок, поэтому из исходника вырезана только нужная дуга: последние
 * 1.875 с (поворот влево) склеены с первыми 1.875 с (поворот вправо).
 * В итоге head.mp4 длится 3.75 с и читается линейно: t=0 — влево на 45°,
 * t=1.875 — анфас, t=3.75 — вправо на 45°. Никакой обработки перехода
 * через границу лупа в коде не нужно.
 *
 * Файл перекодирован all-intra (каждый кадр ключевой): без этого перемотка
 * рвётся — в исходнике на 15 секунд приходилось два ключевых кадра.
 *
 * ── Две оси и мобильный режим (P11-T4, 05.08.2026) ──────────────────────
 * Горизонталь не изменилась — currentTime по курсору/скроллу, как раньше.
 * Вертикаль — новая: наклон ±4° (DESIGN.md §4), transform вешается прямо
 * на <video>, не на предка (тот же принцип, что раньше держал mix-blend-mode
 * живым, сейчас важен просто потому, что так сказано в карточке).
 *
 * mix-blend-mode: multiply снят. Раньше он убирал белый фон исходника,
 * но конфликтовал с transform на предке (⚠️ DESIGN.md §6/§4: transform,
 * opacity или z-index на предке видео с mix-blend-mode рисуют белый
 * прямоугольник вокруг головы — это и произошло бы при наклоне). Фон
 * страницы (--color-bg) и фон видео совпадают до пикселя — оба чистый
 * белый, поэтому квадратные края видео и без наложения не видны на
 * плоском белом фоне. Отдельно — круглая маска: `.hero__media` теперь
 * `border-radius: 50%; overflow: hidden;`, обрезает и постер, и видео
 * в круг физически, а не цветовым совпадением. Это надёжнее старого
 * приёма и одновременно снимает сам конфликт: transform крутит <video>
 * внутри уже обрезанного окна, наложения на предке больше нет вовсе.
 *
 * Поведение по устройствам:
 *   — мышь (pointer: fine): currentTime по горизонтали курсора, наклон
 *     ±4° по вертикали курсора, оба сглажены тем же RAF-циклом;
 *   — тач/без точного указателя: currentTime следует за прогрессом
 *     прокрутки первого экрана (DESIGN.md §4 «Аватар, мобильный») —
 *     второй оси нет, курсора нет, наклон не применяется; видео при этом
 *     ГРУЗИТСЯ (раньше не грузилось вовсе на тач — известный дефект,
 *     исправлен здесь же);
 *   — prefers-reduced-motion: видео не грузится совсем, виден статичный
 *     постер анфас (DESIGN.md §4, без исключений по устройству).
 *
 * Бюджет (DESIGN.md §6): файл 1.6 МБ грузится по IntersectionObserver
 * только когда герой попал в поле зрения — правило не привязано к типу
 * указателя, действует и для мыши, и для тач.
 *
 * ── Появление при скролле (P11-T5) ───────────────────────────────────────
 * Четыре data-reveal на медиа/имя/специализацию/сегменты — лесенка внутри
 * блока (DESIGN.md §4: 90 мс на каждый следующий), а не общий data-reveal
 * на всю <section class="hero"> сразу: герой на первом экране виден целиком
 * с самого начала, без лесенки все четыре элемента проявились бы одним
 * кадром. Общий IntersectionObserver — в Base.astro, здесь только разметка
 * и --reveal-delay (0/90/180/270 мс).
 */
import { withBase } from '../lib/url';

const poster = withBase('media/avatar/head-poster.webp');
const video = withBase('media/avatar/head.mp4');
---

<section class="hero">
	<div class="hero__media" data-hero-media data-reveal style="--reveal-delay: 0ms">
		<img class="hero__poster" src={poster} alt="Кирилл Колобанов" width="1240" height="1240" />
		<video
			class="hero__video"
			data-hero-video
			src={video}
			muted
			playsinline
			preload="none"
			aria-hidden="true"
			tabindex="-1"></video>
	</div>
	<h1 class="hero__name" data-reveal style="--reveal-delay: 90ms">Кирилл Колобанов</h1>
	<h2 class="hero__specialization" data-reveal style="--reveal-delay: 180ms">UX/UI дизайнер, 3 года опыта</h2>
	<p class="hero__segments" data-reveal style="--reveal-delay: 270ms">B2B, B2C</p>
</section>

<style>
	/*
	 * Выравнивание по центру — из макета: фото 620×620 стоит в 408–1028 при
	 * ширине 1440, имя 341–1100, специализация 281–1160, сегменты 631–810.
	 * У всех четырёх блоков центр приходится на 720 — весь герой центрирован.
	 */
	.hero {
		text-align: center;
	}

	/*
	 * P11-T4: круглая маска на .hero__media (border-radius + overflow:hidden)
	 * обрезает квадратные края постера и видео физически — mix-blend-mode
	 * больше не нужен (см. комментарий в начале файла). transform на самом
	 * .hero__media по-прежнему не нужен: наклон применяется к <video>
	 * (тег ниже), а не к обёртке.
	 */
	.hero__media {
		margin-inline: auto;
		position: relative;
		width: min(620px, 100%);
		aspect-ratio: 1 / 1;
		border-radius: 50%; /* DESIGN.md §2 «Скругления»: аватар — круг */
		overflow: hidden;
	}

	.hero__poster,
	.hero__video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero__video {
		position: absolute;
		inset: 0;
		visibility: hidden; /* показывается скриптом, только если видео действительно загрузилось */
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__video {
			display: none; /* скрипт и так не грузит видео при reduced motion — на всякий случай и в разметке */
		}
	}

	.hero__media[data-active='true'] .hero__video {
		visibility: visible;
	}

	.hero__media[data-active='true'] .hero__poster {
		visibility: hidden;
	}

	.hero__name {
		margin-top: var(--space-photo-to-name); /* 0px, DESIGN.md §2: фото и имя примыкают */
	}

	.hero__specialization {
		margin-top: var(--space-name-to-specialization);
	}

	.hero__segments {
		margin-top: var(--space-specialization-to-segments);
		max-width: none; /* переопределение 66ch из typography.css: короткая строка метаданных */
		font-family: var(--font-body);
		font-size: var(--text-segments-size);
		line-height: var(--text-segments-line-height);
		font-weight: var(--text-segments-weight);
		color: var(--color-text-muted); /* DESIGN.md §2: строка сегментов «B2B, B2C» */
	}
</style>

<script>
	/*
	 * Отслеживание курсора/скролла. Горизонталь — позиция отображается в
	 * currentTime линейно, это работает только потому, что исходник снят
	 * с постоянной угловой скоростью (см. references/03_motion). Вертикаль
	 * (только при курсоре) — наклон ±4° самого <video> (P11-T4, DESIGN.md §4).
	 *
	 * Направление: DIRECTION = 1 — курсор/скролл вправо-вперёд поворачивает
	 * голову к концу клипа. Если на живом сайте голова смотрит в
	 * противоположную сторону, поменяйте на -1: единственная строка,
	 * которую нужно трогать.
	 */
	const DIRECTION = -1;
	const SMOOTHING = 0.12; // доля пути к цели за кадр: меньше — плавнее и «ленивее»
	const MAX_TILT_DEG = 4; // DESIGN.md §4: наклон ±4°

	const media = document.querySelector<HTMLElement>('[data-hero-media]');
	const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

	const finePointer = window.matchMedia('(pointer: fine)').matches;
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (media && video && !reducedMotion) {
		let targetPosition = 0.5; // currentTime: 0 — влево, 0.5 — анфас, 1 — вправо
		let currentPosition = 0.5;
		let targetTilt = 0; // deg, только при точном указателе — на тач второй оси нет
		let currentTilt = 0;
		let raf = 0;

		if (finePointer) {
			// десктоп: обе оси по курсору
			const onMove = (event: PointerEvent) => {
				const ratioX = event.clientX / window.innerWidth;
				targetPosition = DIRECTION === 1 ? ratioX : 1 - ratioX;
				const ratioY = event.clientY / window.innerHeight;
				targetTilt = (ratioY - 0.5) * 2 * MAX_TILT_DEG;
			};
			window.addEventListener('pointermove', onMove, { passive: true });
		} else {
			// P11-T4, DESIGN.md §4 «Аватар, мобильный»: курсора нет — горизонталь
			// следует за прогрессом прокрутки первого экрана, наклона нет
			const onScroll = () => {
				const progress = Math.min(Math.max(window.scrollY / window.innerHeight, 0), 1);
				targetPosition = DIRECTION === 1 ? progress : 1 - progress;
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			onScroll();
		}

		const tick = () => {
			currentPosition += (targetPosition - currentPosition) * SMOOTHING;
			currentTilt += (targetTilt - currentTilt) * SMOOTHING;
			if (video.duration) {
				// края клипа не трогаем: на самом последнем кадре часть браузеров подвисает
				video.currentTime = Math.min(Math.max(currentPosition, 0.001), 0.999) * video.duration;
			}
			video.style.transform = `rotate(${currentTilt.toFixed(2)}deg)`; // на <video>, не на предке — DESIGN.md §4
			raf = requestAnimationFrame(tick);
		};

		video.addEventListener(
			'loadeddata',
			() => {
				media.dataset.active = 'true';
				video.currentTime = video.duration / 2; // анфас как стартовое положение
				raf = requestAnimationFrame(tick);
			},
			{ once: true }
		);

		video.addEventListener('error', () => cancelAnimationFrame(raf), { once: true });

		// грузим только когда герой попал в поле зрения — первый экран не ждёт 1.6 МБ.
		// Раньше условие финального if включало finePointer, и на тач видео не
		// грузилось вовсе (известный дефект) — теперь грузится при любом указателе,
		// не грузится только при reduced-motion (внешнее условие блока).
		const observer = new IntersectionObserver((entries) => {
			if (entries.some((entry) => entry.isIntersecting)) {
				video.preload = 'auto';
				video.load();
				observer.disconnect();
			}
		});
		observer.observe(media);
	}
</script>
