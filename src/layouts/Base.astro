---
/*
 * Базовый макет — DESIGN.md §3: <head> с мета-тегами, подключение токенов,
 * шапка, слот содержимого страницы, подвал. Используется всеми страницами.
 *
 * Фавиконки собраны через import.meta.env.BASE_URL — до этого файла пути
 * были абсолютными без учёта base ('/job_case_portfolio_k') и давали 404
 * на проде (замечено в JOURNAL после P3-T2).
 */
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/typography.css';
import '../styles/layout.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
