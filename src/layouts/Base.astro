---
/*
 * Базовый макет — DESIGN.md §3: <head> с мета-тегами, подключение токенов,
 * шапка, слот содержимого страницы, подвал. Используется всеми страницами.
 *
 * Фавиконки собраны через import.meta.env.BASE_URL — до этого файла пути
 * были абсолютными без учёта base ('/job_case_portfolio_k') и давали 404
 * на проде (замечено в JOURNAL после P3-T2).
 *
 * P11-T2: [data-viewport-sentinel] — невидимый маркер высотой в один экран
 * в самом начале body. Header.astro наблюдает за ним через IntersectionObserver,
 * чтобы понять, что пользователь пролистал дальше первого экрана (DESIGN.md
 * §4: «скролл > высоты героя»), — единый триггер работает и на главной
 * (где это буквально высота героя), и на странице кейса/404, где героя нет
 * вовсе, но шапка обязана вести себя так же. position: absolute без
 * позиционированного предка ставит его в начало документа и не смещает
 * остальную вёрстку (containing block — не body, а вся страница).
 *
 * P11-T3: подвал несёт навигацию «На главную» (DESIGN.md §3) — Base.astro
 * прокидывает showHomeLink, везде true, кроме главной (незачем вести
 * с главной на главную). Пропс nextWork убран 09.08.2026 вместе со
 * «Следующий проект» в подвале — см. комментарий в Footer.astro.
 *
 * P11-T5: глобальный наблюдатель анимаций появления (DESIGN.md §4). Один
 * IntersectionObserver на всё дерево [data-reveal] — компонент сам решает,
 * какие свои элементы помечать этим атрибутом (Hero, CaseRow, блоки
 * страницы кейса), Base.astro только один раз включает механику после
 * полной загрузки разметки. Шапка и подвал в выборку не входят (MASTER_PLAN
 * P11-T5 «Не делать») — они не помечены [data-reveal] нигде в коде.
 */
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/typography.css';
import '../styles/layout.css';
import '../styles/reveal.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { withBase } from '../lib/url';

interface Props {
	title: string;
	/** Ссылка «На главную» в подвале. По умолчанию true — снята только на самой главной. */
	showHomeLink?: boolean;
}

const { title, showHomeLink = true } = Astro.props;
// пути — через общий withBase (src/lib/url.ts)
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="icon" href={withBase('favicon.ico')} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style>
			.viewport-sentinel {
				position: absolute;
				top: 0;
				left: 0;
				width: 1px;
				height: 100vh; /* один экран — приближение «высоты героя» без зависимости от того, есть ли герой на странице */
				pointer-events: none;
			}

			/* Второй, короткий сентинел — для сворачивания панели контактов.
			   Кнопка «наверх» по-прежнему смотрит на экранный сентинел выше:
			   ей появляться сразу незачем, наверх и так близко. А панель
			   должна сворачиваться, едва страница тронулась с места. */
			.header-sentinel {
				position: absolute;
				top: 0;
				left: 0;
				width: 1px;
				height: var(--space-sticky-header);
				pointer-events: none;
			}
		</style>
	</head>
	<body>
		<div class="viewport-sentinel" data-viewport-sentinel aria-hidden="true"></div>
		<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
		<Header />
		<main>
			<slot />
		</main>
		<Footer showHomeLink={showHomeLink} />
		<BackToTop />
		<script>
			/*
			 * P11-T5: появление блоков при скролле. Один общий наблюдатель на все
			 * [data-reveal]-элементы страницы — порог 15% (DESIGN.md §4), после
			 * первого срабатывания элемент снимается с наблюдения, чтобы обратная
			 * прокрутка не прятала и не перезапускала анимацию (карточка, «готово
			 * когда»: повторный проход вверх-вниз не перезапускает анимацию).
			 * prefers-reduced-motion — класс проставляется сразу всем, без
			 * наблюдения: reveal.css при этом состоянии и так убирает transition,
			 * но без класса элементы остались бы с opacity: 0 навсегда.
			 */
			const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (reducedMotion) {
				items.forEach((item) => item.classList.add('is-revealed'));
			} else if (items.length > 0) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							// Правка 05.08.2026: класс переключается в обе стороны —
							// элемент, ушедший из вида, снова скрывается и при
							// следующем появлении анимируется заново (прямой запрос
							// пользователя: «чтобы срабатывали всегда»).
							entry.target.classList.toggle('is-revealed', entry.isIntersecting);
						}
					},
					{
						// Порог 0.15 на высоком блоке срабатывал, когда тот едва выглянул
						// снизу: анимация успевала пройти за краем экрана, и пользователь
						// видел статику. rootMargin -20% снизу переносит срабатывание на
						// момент, когда верх блока поднялся на пятую часть экрана — там
						// движение действительно видно (замечание от 05.08.2026).
						threshold: 0,
						rootMargin: '0px 0px -20% 0px'
					}
				);
				// Двойной requestAnimationFrame перед первым observe(): без него элементы,
				// уже находящиеся в зоне видимости при загрузке (герой, первая карточка
				// на высоких экранах), могли получить .is-revealed в том же кадре, что и
				// исходное opacity: 0 — браузер ни разу не рисовал скрытое состояние,
				// и переход был не виден вовсе (карточки просто появлялись статично).
				// Два кадра гарантируют, что скрытое состояние успело отрисоваться.
				requestAnimationFrame(() => {
					requestAnimationFrame(() => {
						items.forEach((item) => observer.observe(item));
					});
				});
			}
		</script>

		<script>
			/*
			 * Мягкая доводка до блока. Заменила CSS-привязку scroll-snap
			 * 09.08.2026 после второго замечания заказчика: «резкое
			 * центрирование блока, он должен плавно подтягивать страницу».
			 *
			 * Почему не CSS. scroll-snap доводит мгновенно, и повлиять на это
			 * нечем: scroll-behavior управляет ПРОГРАММНОЙ прокруткой, а
			 * доводку после жеста браузер выполняет одним кадром, игнорируя
			 * его. Первая попытка чинить это через scroll-behavior: smooth
			 * симптом не убрала — проверено на живом сайте.
			 *
			 * Здесь наоборот: привязки в CSS нет вовсе, а доводку выполняет
			 * scrollTo({ behavior: 'smooth' }) — то самое программное
			 * перемещение, которое браузер анимирует.
			 *
			 * Логика повторяет режим proximity, а не mandatory: подтягиваем,
			 * только если пользователь остановился достаточно близко к границе
			 * блока. Порог 20% высоты экрана — то же число, что уже принято
			 * в rootMargin наблюдателя появления блоков выше.
			 */
			const snapTargets = document.querySelectorAll<HTMLElement>('[data-snap]');
			const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

			if (snapTargets.length > 0) {
				let idleTimer = 0;

				const settle = () => {
					// ближайшая граница блока относительно верха окна
					let nearest = Infinity;
					for (const target of snapTargets) {
						const offset = target.getBoundingClientRect().top;
						if (Math.abs(offset) < Math.abs(nearest)) nearest = offset;
					}

					// 2px — мёртвая зона: без неё доводка запускала бы сама себя
					// по собственным же событиям прокрутки
					const threshold = window.innerHeight * 0.2;
					if (Math.abs(nearest) > 2 && Math.abs(nearest) <= threshold) {
						window.scrollTo({ top: window.scrollY + nearest, behavior: 'smooth' });
					}
				};

				window.addEventListener(
					'scroll',
					() => {
						if (reducedMotionQuery.matches) return; // движение, которого пользователь не просил
						window.clearTimeout(idleTimer);
						// доводим только после остановки, чтобы не бороться с жестом
						idleTimer = window.setTimeout(settle, 140);
					},
					{ passive: true }
				);
			}
		</script>
	</body>
</html>
