---
/*
 * Страница кейса — DESIGN.md §3, «Страница кейса, десктоп», редакция
 * 02.09.2026. Переписана по макету [552:1006] (1440 × 9357, белый фон,
 * боковое поле 140, колонка 1160).
 *
 * Маршрут по коллекции works через getStaticPaths (Content Layer API:
 * путь строится из entry.id, поля slug нет — ловушка проекта).
 *
 * ── Что ушло со страницы 02.09.2026 ──────────────────────────────────────
 * Галерея (CaseGallery), переход «Следующий кейс» (CaseNav), метаданные
 * год/роль/категория списком, кнопки шапки. Ничего этого в макете нет,
 * решение заказчика: «всё делать как в макете». Компоненты остались
 * в репозитории — снят вызов, не файл.
 *
 * ── Ширина колонки ───────────────────────────────────────────────────────
 * .case-block-width (ширина от высоты окна) больше не участвует: в макете
 * колонка кейса — это обычный контент-контейнер, 1160 при поле 140.
 * Существующий --space-content-padding даёт ровно это на 1440.
 *
 * ── Тело страницы ────────────────────────────────────────────────────────
 * Рисуется из frontmatter-поля blocks (см. src/content.config.ts). Кейс
 * без blocks рендерится по-старому, из markdown-тела — так держится
 * второй кейс (jobs), у которого своей структуры ещё нет.
 *
 * P11-T5: data-reveal на блоках страницы (DESIGN.md §4). Кнопки не
 * помечены — это навигация в одну строку, а не блок.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseMedia from '../../components/CaseMedia.astro';
import PillButton from '../../components/PillButton.astro';
import QuoteCards from '../../components/QuoteCards.astro';
import ScreensPanel from '../../components/ScreensPanel.astro';
import { contacts } from '../../data/contacts.ts';

export async function getStaticPaths() {
	const works = await getCollection('works');
	return works.map((work) => ({
		params: { id: work.id },
		props: { work },
	}));
}

interface Props {
	work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, heading, video, poster, readingTime, blocks } = work.data;
const { Content } = await render(work);

// Заголовок страницы кейса и подпись в ленте — разные строки макета.
const pageHeading = heading ?? title;

// Тот же адрес, что в шапке и подвале — DESIGN.md §3, «Контакты — один источник».
const telegram = contacts.find((contact) => contact.icon === 'telegram');

const hasBlocks = blocks.length > 0;
---

<Base title={`${title} — Кирилл Колобанов`} bareHeader>
	<article class="container case">
		<p class="case__back">
			<PillButton label="На главную" href="/" icon="arrow-left" />
		</p>

		<h1 class="case__title" data-reveal>{pageHeading}</h1>

		<div class="case__media" data-reveal>
			<CaseMedia video={video} poster={poster} alt={`Превью кейса «${title}»`} eager />
		</div>

		{readingTime && <p class="case__reading-time" data-reveal>{readingTime}</p>}

		{
			hasBlocks
				? blocks.map((block) => {
						if (block.type === 'cards') {
							return (
								<div data-reveal>
									<QuoteCards items={block.items} />
								</div>
							);
						}

						if (block.type === 'screens') {
							return (
								<div data-reveal>
									<ScreensPanel screens={block.screens} label={block.label ?? title} />
								</div>
							);
						}

						if (block.type === 'scenario') {
							return (
								<section class="case-scenario" data-reveal>
									<h3 class="case-scenario__title">{block.title}</h3>
									<p class="case-scenario__body">{block.body}</p>
									{block.screens.length > 0 && (
										<div class="case-scenario__screens">
											<ScreensPanel screens={block.screens} label={block.title} />
										</div>
									)}
								</section>
							);
						}

						return (
							<section class="case-section" data-reveal>
								<h2 class="case-section__title">{block.title}</h2>
								{block.body && <p class="case-section__body">{block.body}</p>}
								{block.items && block.items.length > 0 && (
									<ul class="case-section__list">
										{block.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								)}
							</section>
						);
					})
				: (
						<div class="case__markdown" data-reveal>
							<Content />
						</div>
					)
		}

		<div class="case__cta">
			<PillButton label="На главную" href="/" icon="arrow-left" />
			{
				telegram && (
					<PillButton
						label="Обсудить в Telegram"
						href={telegram.href}
						variant="solid"
						external
						hint=" (откроется в новом окне)"
					/>
				)
			}
		</div>
	</article>
</Base>

<style>
	/*
	 * Вертикальный ритм — DESIGN.md §2, «Шкала отступов страницы кейса».
	 * Отступы держатся на margin-top у детей, а не на flex-gap: шаг между
	 * блоками не один (32 по умолчанию, но 20 до медиа, 24 вокруг строки
	 * времени, 48 до кнопок), и общий gap пришлось бы вычитать обратно
	 * отрицательными полями. Флекс-контейнер при этом нужен: он отменяет
	 * схлопывание полей, из-за которого margin первого ребёнка утекал бы
	 * наружу статьи.
	 */
	.case {
		display: flex;
		flex-direction: column;
		padding-top: var(--space-header-top); /* верх страницы → кнопка «На главную», 60 в макете */
		padding-bottom: var(--space-case-cta-bottom); /* кнопки → полоса подвала */
	}

	.case > * + * {
		margin-top: var(--space-case-block);
	}

	/*
	 * Ниже — исключения из шага «блок → блок». Селекторы обязательно
	 * с `.case > `: Astro дописывает к каждому компаунду свой атрибут
	 * области видимости, и правило `.case > * + *` весит четыре единицы
	 * специфичности против двух у голого класса. Без родителя исключения
	 * молча не срабатывали — проверено замером, медиа стояло на 32 вместо 20.
	 */
	.case > .case__media {
		margin-top: var(--space-case-media); /* H1 → медиа */
	}

	.case > .case__reading-time {
		margin-top: var(--space-case-note); /* медиа → строка времени */
	}

	.case__reading-time {
		color: var(--color-text-subtle);
		font-size: var(--text-case-body-size);
		line-height: var(--text-case-body-line-height);
		font-weight: var(--text-case-body-weight);
	}

	.case > .case__reading-time + * {
		margin-top: var(--space-case-note); /* строка времени → первый раздел */
	}

	.case > .case__cta {
		margin-top: var(--space-case-cta-top);
	}

	.case__cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between; /* в макете кнопки разведены по краям колонки: x=140 и правый край 1300 */
		gap: var(--space-case-cards-gap);
	}

	/* Кнопка «На главную» стоит в потоке первой; отступ сверху даёт
	   padding-top контейнера, своего не нужно. */
	.case__back {
		display: flex;
	}

	/*
	 * Заголовок страницы набран тем же кеглем, что заголовки разделов
	 * (Raleway SemiBold 32, [552:5596]) — это не упущение съёма, а решение
	 * макета: страница кейса живёт без крупного титула.
	 */
	.case__title {
		font-family: var(--font-body);
		font-size: var(--text-case-section-size);
		line-height: var(--text-case-section-line-height);
		font-weight: var(--text-case-section-weight);
		color: var(--color-text);
	}

	/* Hero-медиа кейса: 1160 × 650 на почти чёрном, радиус 32 [548:4884].
	   Пропорцией, а не пикселями — колонка сужается вместе с окном.
	   Базовое правило .case-media (layout.css) даёт 5:4 и светлую заглушку;
	   тот же приём локального переопределения уже применён в CaseRow. */
	.case :global(.case-media) {
		aspect-ratio: 1160 / 650;
		background-color: var(--color-surface-dark);
	}

	/* ── Текстовый раздел ──────────────────────────────────────────────── */
	.case-section__title {
		font-family: var(--font-body);
		font-size: var(--text-case-section-size);
		line-height: var(--text-case-section-line-height);
		font-weight: var(--text-case-section-weight);
		color: var(--color-text);
	}

	.case-section__body,
	.case-section__list,
	.case-scenario__body {
		margin-top: var(--space-case-heading); /* заголовок → его собственный текст */
		font-size: var(--text-case-body-size);
		line-height: var(--text-case-body-line-height);
		font-weight: var(--text-case-body-weight);
		color: var(--color-text);
	}

	/* Абзацы «Конкурентов» разбиты переносом внутри одной строки данных —
	   в макете это один текстовый блок с ручным переносом, не два абзаца. */
	.case-section__body {
		white-space: pre-line;
	}

	/* У раздела с вводной фразой и списком (Метрики, «Что бы я сделал ещё»)
	   список идёт сразу за абзацем, без второго шага в 16. */
	.case-section__body + .case-section__list {
		margin-top: var(--space-case-heading);
	}

	.case-section__list {
		padding-left: 1.25em; /* маркер не должен вылезать за левый край колонки */
		list-style: disc;
	}

	/* ── Сценарий: подзаголовок, текст, панель экранов ─────────────────── */
	.case-scenario__title {
		font-family: var(--font-body);
		font-size: var(--text-case-scenario-size);
		line-height: var(--text-case-scenario-line-height);
		font-weight: var(--text-case-scenario-weight);
		color: var(--color-text);
	}

	.case-scenario__screens {
		margin-top: var(--space-case-media); /* текст → медиа */
	}

	/* ── Запасной путь: кейс без blocks ────────────────────────────────── */
	.case__markdown :global(h2) {
		font-family: var(--font-body);
		font-size: var(--text-case-section-size);
		line-height: var(--text-case-section-line-height);
		font-weight: var(--text-case-section-weight);
		margin-top: var(--space-case-block);
	}

	.case__markdown :global(h2:first-child) {
		margin-top: 0;
	}

	.case__markdown :global(p) {
		margin-top: var(--space-case-heading);
		font-size: var(--text-case-body-size);
		line-height: var(--text-case-body-line-height);
	}
</style>
