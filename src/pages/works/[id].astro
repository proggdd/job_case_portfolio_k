---
/*
 * Страница кейса — DESIGN.md §3 «Схема», карточка P5-T3. Маршрут по
 * коллекции works через getStaticPaths (Content Layer API: путь строится
 * из entry.id, не entry.slug — известная ловушка проекта, MASTER_PLAN
 * «Известные ловушки» п.2).
 *
 * Заголовок — единственный <h1> ЭТОЙ страницы (DESIGN.md §8: один H1 на
 * страницу, у каждой страницы своя иерархия — не конфликтует с H1 «имя»
 * на главной, это разные страницы). Стиль h1 и h2 внутри Content ниже
 * переиспользуют токены --text-case-title-* (заголовок кейса, DESIGN.md §2):
 * отдельной типографической роли «заголовок страницы кейса» и «подзаголовок
 * блока кейса» в спецификации нет — не изобретено новое значение, взято
 * уже измеренное, тем же приёмом, что число колонок сетки в P4-T3.
 *
 * Метаданные (DESIGN.md §3, модель данных кейса): год, роль, категория
 * (segment). Поля «клиент» в модели нет — исключено намеренно, в макете
 * его нет (DESIGN.md §3: «Поля client нет намеренно»); карточка в
 * MASTER_PLAN упоминает клиента в общей формулировке, но модель данных —
 * более детальный и замороженный источник (тот же приоритет, что был
 * выбран для состава подвала в P5-T1, см. комментарий Footer.astro).
 *
 * Блоки «задача, решение, результат» — тело markdown-файла (`description`
 * из DESIGN.md — это body коллекции, не поле схемы, P3-T3), с реальным
 * текстом от дизайнера в Ф6 (P6-T2). На MVP — текст-рыба с той же
 * структурой заголовков.
 *
 * Основное медиа кейса (video/poster) показано тем же компонентом
 * CaseMedia, что и на главной — модель данных явно описывает `video` как
 * «основное видео кейса», переиспользование не нарушает границы карточки.
 *
 * Возврат на главную: явная ссылка в начале страницы. Шапка сейчас не
 * даёт такой ссылки — аватар в Header.astro не обёрнут в <a> (P5-T1),
 * трогать шапку вне границ этой карточки (правило 7 мастер-плана). С P11-T3
 * такая же ссылка есть и в подвале (Footer.astro) — не дублирование
 * по ошибке, а расчёт на то, что после исчезновения шапки у подвала
 * (P11-T2) до верхней ссылки пришлось бы скроллить обратно.
 * «Следующий кейс» в подвале (CaseNav с nextWork) убран 09.08.2026 по
 * замечанию заказчика: та же ссылка уже стоит в CaseNav ниже, в двух шагах
 * прокрутки — там дубль без пользы, не запасной адрес. «На главную» в
 * подвале эта логика не касается: в теле кейса такой ссылки нет вовсе.
 *
 * P11-T5: data-reveal на header/медиа/контент/галерею/нав — «блоки страницы
 * кейса» из DESIGN.md §4. Ссылка «На главную» этим приёмом не помечена —
 * она мелкий навигационный элемент в одну строку, а не блок. CaseMedia,
 * CaseGallery и CaseNav — самостоятельные компоненты без своего data-reveal
 * внутри (переиспользуются и на главной, и в подвале, где отдельная
 * анимация появления не нужна — CaseRow.astro уже помечает d-reveal всю
 * строку целиком, а подвал вообще исключён карточкой), поэтому здесь
 * обёрнуты в свои <div data-reveal> снаружи, без правок самих компонентов.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseMedia from '../../components/CaseMedia.astro';
import CaseGallery from '../../components/CaseGallery.astro';
import CaseNav from '../../components/CaseNav.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
	const works = await getCollection('works');
	return works.map((work) => ({
		params: { id: work.id },
		props: { work },
	}));
}

interface Props {
	work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, year, role, segment, video, poster, images } = work.data;
const { Content } = await render(work);

const orderedWorks = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = orderedWorks.findIndex((entry) => entry.id === work.id);
const prevWork = currentIndex > 0 ? orderedWorks[currentIndex - 1] : undefined;
const nextWork = currentIndex < orderedWorks.length - 1 ? orderedWorks[currentIndex + 1] : undefined;

---

<Base title={`${title} — Кирилл Колобанов`}>
	<article class="container">
		<div class="case-page case-block-width">
			<div class="case-page__hero">
				<header class="case-page__header" data-reveal>
					<h1 class="case-page__title">{title}</h1>
					<dl class="case-page__meta">
						<div class="case-page__meta-item">
							<dt>Год</dt>
							<dd>{year}</dd>
						</div>
						<div class="case-page__meta-item">
							<dt>Роль</dt>
							<dd>{role}</dd>
						</div>
						<div class="case-page__meta-item">
							<dt>Категория</dt>
							<dd>{segment}</dd>
						</div>
					</dl>
				</header>

				<div data-reveal>
					<CaseMedia video={video} poster={poster} alt={`Превью кейса «${title}»`} eager />
				</div>
			</div>

			<div class="case-page__content" data-reveal>
				<Content />
			</div>

			{
				images.length > 0 && (
					<div data-reveal>
						<CaseGallery images={images} title={title} />
					</div>
				)
			}

			<div data-reveal>
				<CaseNav prev={prevWork} next={nextWork} />
			</div>
		</div>
	</article>
</Base>

<style>
	/*
	 * Правка 09.08.2026 по замечанию заказчика: «страницы, которые подключены
	 * к карточкам внутри, тоже неказистые — небольшая картинка, надписи по
	 * краям с равнением по левому центру, сделай красиво».
	 *
	 * Что было и почему выглядело так: содержимое шло во всю ширину
	 * контейнера (1436px на 1536-м экране), а заголовок страницы стоял
	 * в 24px — том же размере, что мелкая подпись карточки на главной.
	 * Получалась строка текста от края до края под крошечным заголовком.
	 *
	 * Что стало: вся страница — одна колонка .case-block-width, ровно той же
	 * ширины, что карточка кейса на главной. Переход с ленты на страницу
	 * теперь не меняет ширину колонки, и это тот самый «единый блок».
	 */
	.case-page {
		/* Отступ от потолка — правка 13.08.2026: шапка налезала на заголовок
		   кейса. Прежняя версия (коммит 39ba957) буквально скопировала приём
		   .hero из Hero.astro — margin-top: --space-hero-top, а с 1024px
		   минус высота шапки --space-sticky-header, чтобы контент затягивало
		   под прозрачную шапку (она не в потоке отжимает, а стоит поверх).
		   На главной в эту 30-пиксельную зону нахлёста (86-116px) попадает
		   только фотография героя — она играет с шапкой в один приём z-index
		   (Hero.astro, .hero__media) и не мешает читать текст. На странице
		   кейса первым блоком идёт не фото, а сразу <h1> — тот же нахлёст
		   утаскивал под шапку живой текст заголовка. Вычитание убрано,
		   margin-top — просто --space-hero-top на всех размерах: так уже
		   вело себя всё, что ниже 1024px, — отдельного правила не требовало. */
		margin-top: var(--space-hero-top);
		padding-bottom: var(--space-last-case-to-footer); /* тот же отступ, что перед подвалом на главной */
		display: flex;
		flex-direction: column;
		gap: var(--space-case-to-case); /* между крупными блоками страницы — токен «кейс → кейс», своего в DESIGN.md нет */
	}

	/*
	 * Первый шаг страницы: заголовок и картинка одним блоком, без пустоты
	 * между ними — правка 09.08.2026 по замечанию заказчика: «в блоке должно
	 * быть видно всё шагами, первый это картинка + надпись, сейчас пустота».
	 *
	 * Раньше ссылка «На главную», заголовок и медиа были прямыми детьми
	 * .case-page и разделялись общим gap: var(--space-case-to-case) (80px)
	 * ДВАЖДЫ — между ссылкой и заголовком, и между заголовком и медиа.
	 * Токен «кейс → кейс» рассчитан на разделение самостоятельных секций
	 * страницы (эту секцию от текста кейса, текст от галереи), а не связку
	 * заголовка с его собственной иллюстрацией — отсюда и читалось как
	 * разрыв, а не единый блок.
	 *
	 * Ссылка «На главную» выведена из вертикального ритма — это элемент
	 * навигации, а не содержимое, ему нет смысла отъедать высоту у картинки.
	 * position: relative на обёртке нужен, чтобы position: absolute у ссылки
	 * (ниже) считался от неё, а не от предка выше по дереву.
	 *
	 * data-snap здесь был тем же приёмом, что у карточек кейсов на главной —
	 * доводчик убран целиком по просьбе заказчика (PLAN-PATCH-2026-08-11.md,
	 * B3), атрибут снят.
	 */
	/* Ссылка «На главную» отсюда убрана 09.08.2026: её обрезала плавающая
	   шапка и по ней нельзя было попасть. Теперь это стеклянная кнопка
	   в самой шапке слева, зеркально кнопке контактов (Header.astro),
	   поэтому отступ сверху под неё здесь больше не нужен. */
	.case-page__hero {
		display: flex;
		flex-direction: column;
		gap: var(--space-subtitle-to-media); /* заголовок → медиа, тот же токен, что «подзаголовок → медиа» на главной — своей роли для этой пары в DESIGN.md нет */
	}

	/* Заголовок и метаданные — одна группа, разделённая волосяной линией:
	   год, роль и категория читаются как подпись под названием работы,
	   а не как ещё один абзац текста. */
	.case-page__header {
		display: flex;
		flex-direction: column;
		gap: var(--space-case-title-to-subtitle); /* заголовок → метаданные, токен «заголовок кейса → подзаголовок» */
	}

	.case-page__title {
		font-family: var(--font-accent); /* дисплейная гарнитура — здесь и на имени в герое, больше нигде (tokens.css) */
		/* Переиспользован токен «специализация» (60px по замеру макета).
		   Своей роли «заголовок страницы кейса» в DESIGN.md §2 нет, а прежние
		   24px — размер мелкой подписи в ленте, для заголовка страницы он мал.
		   Тот же приём переиспользования уже измеренного значения, что
		   применён для числа колонок сетки в P4-T3. */
		font-size: var(--text-specialization-size);
		line-height: var(--text-specialization-line-height);
		font-weight: var(--text-name-weight); /* полужирное, как у имени: это заголовок страницы */
	}

	.case-page__meta {
		display: flex;
		flex-wrap: wrap;
		gap: calc(var(--space-unit) * 8) calc(var(--space-unit) * 6); /* не задано в DESIGN.md, инженерный дефолт на базовой единице */
		padding-top: var(--space-case-title-to-subtitle);
		border-top: 1px solid var(--glass-border); /* волосяная линия — токен окантовки стекла, DESIGN.md §4; своего значения для разделителя в спецификации нет */
		font-family: var(--font-body);
		font-size: var(--text-pill-size);
	}

	.case-page__meta-item {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 1);
	}

	.case-page__meta dt {
		color: var(--color-text-muted);
	}

	.case-page__meta dd {
		color: var(--color-text);
	}

	/* Подзаголовки «Задача / Решение / Результат» из markdown-тела (<h2>) —
	   роли для них в DESIGN.md §2 нет (только «заголовок кейса» 24px для
	   строки на главной). Переопределяет здесь же глобальное правило h2
	   из typography.css (60px, роль «специализация» героя) — то правило
	   для героя, не для тела кейса; повторно используются токены заголовка
	   кейса, тем же приёмом, что и h1 этой страницы выше. */
	.case-page__content :global(h2) {
		font-family: var(--font-display);
		font-size: var(--text-case-title-size);
		line-height: var(--text-case-title-line-height);
		font-weight: var(--text-case-title-weight);
		margin-top: var(--space-case-to-case);
		margin-bottom: var(--space-case-title-to-subtitle);
	}

	.case-page__content :global(h2:first-child) {
		margin-top: 0;
	}

	.case-page__content :global(p) {
		color: var(--color-text-subtle); /* тот же цвет, что подзаголовок кейса на главной, единственный заданный текстовый цвет для длинного текста */
	}
</style>
