---
/*
 * Главная. Герой — P5-T7 (DESIGN.md §3 блок 2, компонент Hero.astro):
 * имя — единственный H1 страницы, специализация H2, дальше без пропусков
 * H3 у заголовков кейсов (CaseRow). Временные типографические образцы Ф4
 * убраны — их роль исчерпана, реальную семантику теперь несут Hero и
 * CaseRow.
 *
 * Лента кейсов — задача P5-T2: данные из коллекции works, показываются
 * только featured, порядок — по полю order (DESIGN.md §3 «Модель данных
 * кейса», карточка P5-T2 шаг 1).
 */
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import CaseRow from '../components/CaseRow.astro';

const works = (await getCollection('works', ({ data }) => data.featured)).sort(
	(a, b) => a.data.order - b.data.order
);
---

<Base title="Кирилл Колобанов — UX/UI дизайнер, 3 года опыта" showHomeLink={false}>
	<div class="container">
		<Hero />

		<ul class="case-grid">
			{works.map((work, index) => <CaseRow work={work} eager={index === 0} />)}
		</ul>
	</div>
</Base>
