---
/*
 * Главная. Лента кейсов — задача P5-T2: данные из коллекции works,
 * показываются только featured, порядок — по полю order (DESIGN.md §3
 * «Модель данных кейса», карточка P5-T2 шаг 1). Герой отдельной карточкой
 * ещё не назначен — образцы типографики Ф4 для его ролей (H1 имя,
 * H2 специализация, H6 сегменты) оставлены как есть, вне границ этой задачи.
 *
 * Для журнала: H3/H4/H5 ниже — те же роли (заголовок кейса, год,
 * подзаголовок), что теперь рендерит CaseRow по реальным данным. Визуальное
 * повторение до появления карточки под герой — замеченное вне задачи,
 * по правилу 7 мастер-плана не трогаю, фиксирую в JOURNAL.
 */
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import CaseRow from '../components/CaseRow.astro';

const works = (await getCollection('works', ({ data }) => data.featured)).sort(
	(a, b) => a.data.order - b.data.order
);
---

<Base title="Кирилл Колобанов — UX/UI дизайнер, 3 года опыта">
	<div class="container">
		<h1>Кирилл Колобанов</h1>
		<h2>UX/UI дизайнер, 3 года опыта</h2>
		<h3>Заголовок кейса</h3>
		<h4>2026</h4>
		<h5>Подзаголовок кейса — обычно занимает две строки, здесь видно межстрочный интервал</h5>
		<h6>B2B, B2C</h6>
		<p>
			Образец абзаца. Роли «абзац» в спецификации нет — размер и межстрочный
			интервал нейтральные, до появления реальных текстов кейсов (K-1).
		</p>
		<small>Подпись — вспомогательный текст тем же стилем, что подзаголовок кейса.</small>

		<ul class="case-grid">
			{works.map((work, index) => <CaseRow work={work} eager={index === 0} />)}
		</ul>
	</div>
</Base>
